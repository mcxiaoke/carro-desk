<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CarroDesk</RootNamespace>
    <AssemblyName>CarroDesk</AssemblyName>
    <StartupObject>CarroDesk.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
    <!-- CLI 单文件发布时 PublishSingleFile 会流入本项目并默认推断 SelfContained=true，
         触发 NETSDK1151（自包含 exe 不可被非自包含 exe 引用），显式关闭 -->
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icon.ico" />
    <Resource Include="Assets\Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Locales\*.json" />
  </ItemGroup>

  <!-- 样例配置：构建时自动复制到输出目录，不走代码生成 -->
  <ItemGroup>
    <None Include="Samples\config.sample.json" Link="config.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Samples\tasks.sample.json" Link="tasks.sample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Samples\portable.sample.ini" Link="portable.sample.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- AI 助手手册：嵌入主程序，经 host.guide 能力下发给 AI（单一事实来源在 docs/） -->
  <ItemGroup>
    <EmbeddedResource Include="..\docs\AI-AGENT-MANUAL.md" Link="Docs\AI-AGENT-MANUAL.md" />
  </ItemGroup>

  <!-- net48 Framework references → NuGet 包（现代 .NET 上为独立包；
       SystemEvents/ProtectedData/Drawing/Extensions 已内置于 net10.0-windows，无需引用） -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- <PackageReference Include="Costura.Fody" Version="6.0.0" PrivateAssets="all" /> -->
    <!-- <PackageReference Include="Fody" Version="6.9.2" PrivateAssets="all" /> -->
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>CarroDesk.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>

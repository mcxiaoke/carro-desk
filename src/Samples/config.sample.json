// CarroDesk 主配置示例
// 放置位置：
//   便携模式（exe 同目录下存在 portable.ini）：<exe目录>\app_data\config.json
//   漫游模式（默认）：%AppData%\CarroDesk\config.json
// 首次启动若不存在会自动生成默认配置，可参考本样例修改。
// 本文件由构建时自动复制到输出目录，仅作参考，不会被程序直接读取。
{
  // --- 宿主配置 (Host) ---
  // 开机自启（写入注册表 Run）
  "AutoStart": true,

  // 界面语言（auto, zh-CN, en-US）
  "Language": "auto",

  // 悬浮面板热键与位置
  "FloatingPanelHotkey": "Win+Alt+C",
  "FloatingPanelPosition": "Tray",
  "FloatingPanelPinned": false,
  "FloatingPanelLocked": false,

  // PIN 盐与哈希（首次设置 PIN 后由 HostPinService 自动生成与维护，无需手填）
  "PinSalt": "",
  "PinHash": "",

  // --- 屏幕保护模块配置 (ScreenLock) ---
  "ScreenLock": {
    "Enabled": true,
    // 空闲多久后锁屏（分钟），0 表示禁用自动锁屏，1-1440
    "IdleMinutes": 5,
    // 锁屏界面是否显示时钟
    "ShowClock": true,
    // 锁屏遮罩透明度 0.3 - 1.0
    "OverlayOpacity": 0.88,
    // Windows 解锁后自动解除伪锁屏
    "UnlockOnResume": true,
    // 排除进程：列出的进程运行时暂停空闲计时，防止游戏/挂机被锁屏
    "ExcludeProcesses": []
  },

  // --- 任务调度模块配置 (TaskScheduler) ---
  "TaskScheduler": {
    "GlobalEnabled": true,
    "TasksFile": "tasks.json"
  },

  // --- 剪贴板历史模块配置 (ClipboardHistory) ---
  "ClipboardHistory": {
    "Enabled": true,
    "AutoRecord": true,
    "Hotkey": "Win+Alt+V",
    "MaxPreviewChars": 100,
    "MaxItems": 1000,
    "RetentionDays": 90
  }
}

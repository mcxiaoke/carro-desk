<Window x:Class="CarroDesk.Modules.ClipboardHistory.Views.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板历史"
        Width="440" Height="520"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12" Foreground="#FF24292F">
    <Window.Resources>
        <!-- 搜索框样式 -->
        <Style x:Key="SearchBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFF8FAFC"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFCBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF0969DA"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表项样式 -->
        <Style x:Key="HistoryItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFE0F2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层发光与投影卡片 -->
    <Border Margin="10" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#FFE2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶部标题与搜索 -->
                <RowDefinition Height="*"/>    <!-- 历史记录列表 -->
                <RowDefinition Height="Auto"/> <!-- 底部状态栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶部操作栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="剪贴板历史" FontWeight="SemiBold" FontSize="14" Foreground="#FF0F172A" VerticalAlignment="Center"/>
                    <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="✕" Width="20" Height="20"
                            Background="Transparent" BorderThickness="0" Foreground="#FF64748B"
                            Cursor="Hand" Click="BtnClose_Click" ToolTip="关闭 (Esc)"/>
                    <TextBlock x:Name="TxtHeaderInfo" Text="" FontSize="11" Foreground="#FF64748B"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </DockPanel>

                <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource SearchBoxStyle}"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
            </Grid>

            <!-- 2. 剪贴板历史列表 -->
            <ListBox x:Name="HistoryList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource HistoryItemStyle}"
                     MouseDoubleClick="HistoryList_MouseDoubleClick"
                     KeyDown="HistoryList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding PreviewText}" FontWeight="Normal"
                                       FontSize="13" Foreground="#FF1E293B" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding FullText}"/>

                            <DockPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="#FF94A3B8"/>
                                <TextBlock Text="{Binding TextLength, StringFormat='{}{0} 字符'}"
                                           FontSize="11" Foreground="#FF94A3B8" DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 无内容时占位提示 -->
            <TextBlock x:Name="TxtEmptyHint" Grid.Row="1" Text="暂无剪贴板历史记录"
                       Foreground="#FF94A3B8" FontSize="13" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed"/>

            <!-- 3. 底部状态与操作说明 -->
            <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,6,0,0" BorderBrush="#FFF1F5F9" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock Text="双击或 Enter 复制并粘贴 | Esc 关闭" FontSize="11" Foreground="#FF94A3B8" VerticalAlignment="Center"/>
                    <Button x:Name="BtnClearAll" DockPanel.Dock="Right" Content="清空" FontSize="11"
                            Foreground="#FFDC2626" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnClearAll_Click" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

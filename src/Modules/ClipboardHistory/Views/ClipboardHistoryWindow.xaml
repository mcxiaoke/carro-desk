<Window x:Class="CarroDesk.Modules.ClipboardHistory.Views.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        Title="剪贴板历史"
        Width="460" Height="540"
        MinWidth="380" MinHeight="360"
        MaxWidth="1400" MaxHeight="1000"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12" Foreground="#FF24292F">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- 右键快捷菜单 -->
        <ContextMenu x:Key="HistoryItemContextMenu">
            <MenuItem Header="{loc:Loc Clipboard.CopyAndPaste, Default='复制并粘贴'}" FontWeight="SemiBold" Click="MenuCopyAndPaste_Click" InputGestureText="Enter"/>
            <MenuItem Header="{loc:Loc Clipboard.CopyOnly, Default='仅复制到剪贴板'}" Click="MenuCopyOnly_Click"/>
            <Separator/>
            <MenuItem Header="{loc:Loc Clipboard.TogglePin, Default='固定置顶 / 取消固定'}" Click="MenuTogglePin_Click"/>
            <MenuItem Header="{loc:Loc Clipboard.DeleteSingle, Default='删除单条'}" Click="MenuDelete_Click" InputGestureText="Del"/>
            <Separator/>
            <MenuItem Header="{loc:Loc Clipboard.ViewDetails, Default='查看完整内容...'}" Click="MenuViewDetails_Click"/>
        </ContextMenu>

        <!-- 搜索框样式 -->
        <Style x:Key="SearchBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#FFF8FAFC"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFCBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF0969DA"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表项样式 -->
        <Style x:Key="HistoryItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContextMenu" Value="{StaticResource HistoryItemContextMenu}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFF1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FFE0F2FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层发光与投影卡片 -->
    <Border Margin="10" Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#FFE2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 顶部标题与搜索 -->
                <RowDefinition Height="*"/>    <!-- 历史记录列表 -->
                <RowDefinition Height="Auto"/> <!-- 底部状态栏 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶部操作栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="{loc:Loc Clipboard.Title, Default='剪贴板历史'}" FontWeight="SemiBold" FontSize="14" Foreground="#FF0F172A" VerticalAlignment="Center"/>
                    <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="✕" Width="20" Height="20"
                            Background="Transparent" BorderThickness="0" Foreground="#FF64748B"
                            Cursor="Hand" Click="BtnClose_Click" ToolTip="{loc:Loc Clipboard.CloseTip, Default='关闭 (Esc)'}"/>
                    <Button x:Name="BtnMaximize" DockPanel.Dock="Right" Content="🗖" Width="20" Height="20"
                            Background="Transparent" BorderThickness="0" Foreground="#FF64748B"
                            Cursor="Hand" Click="BtnMaximize_Click" ToolTip="{loc:Loc Clipboard.MaximizeTip, Default='放大 / 还原窗口'}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtHeaderInfo" Text="" FontSize="11" Foreground="#FF64748B"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </DockPanel>

                <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource SearchBoxStyle}"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
            </Grid>

            <!-- 2. 剪贴板历史列表 -->
            <ListBox x:Name="HistoryList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource HistoryItemStyle}"
                     MouseDoubleClick="HistoryList_MouseDoubleClick"
                     KeyDown="HistoryList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📌" FontSize="11" Margin="0,2,4,0" Foreground="#FF0969DA"
                                           VerticalAlignment="Top"
                                           Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisConverter}}"
                                           ToolTip="{loc:Loc Clipboard.Pinned, Default='已固定置顶'}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PreviewText}" FontWeight="Normal"
                                           FontSize="13" Foreground="#FF1E293B"
                                           TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullText}" VerticalAlignment="Top"/>
                            </Grid>

                            <!-- 行内快捷操作按钮（固定、删除） -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Top">
                                <Button Content="📌" Width="20" Height="20" Background="Transparent" BorderThickness="0"
                                        FontSize="10" Cursor="Hand" ToolTip="{loc:Loc Clipboard.TogglePin, Default='固定置顶 / 取消固定'}"
                                        Click="BtnItemPin_Click" Tag="{Binding}"/>
                                <Button Content="✕" Width="20" Height="20" Background="Transparent" BorderThickness="0"
                                        Foreground="#FFDC2626" FontSize="11" Cursor="Hand" ToolTip="{loc:Loc Clipboard.DeleteSingle, Default='删除单条'}"
                                        Click="BtnItemDelete_Click" Tag="{Binding}" Margin="2,0,0,0"/>
                            </StackPanel>

                            <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="#FF94A3B8"/>
                                <TextBlock Text="{Binding TextLength, StringFormat='{}{0} 字符'}"
                                           FontSize="11" Foreground="#FF94A3B8" DockPanel.Dock="Right"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 无内容时占位提示 -->
            <TextBlock x:Name="TxtEmptyHint" Grid.Row="1" Text="{loc:Loc Clipboard.EmptyHint, Default='暂无剪贴板历史记录'}"
                       Foreground="#FF94A3B8" FontSize="13" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed"/>

            <!-- 3. 底部状态与操作说明 -->
            <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,6,0,0" BorderBrush="#FFF1F5F9" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock Text="{loc:Loc Clipboard.StatusTip, Default='双击/Enter 复制并粘贴 | 右键更多操作 | Esc 关闭'}" FontSize="11" Foreground="#FF94A3B8" VerticalAlignment="Center"/>
                    <Thumb x:Name="ResizeGripThumb" DockPanel.Dock="Right" Width="14" Height="14" Cursor="SizeNWSE"
                           Margin="6,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                           DragDelta="ResizeGripThumb_DragDelta" ToolTip="{loc:Loc Clipboard.ResizeTip, Default='拖拽调整窗口大小'}">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Grid Background="Transparent">
                                    <Path Data="M 9,13 L 13,9 M 5,13 L 13,5 M 1,13 L 13,1"
                                          Stroke="#FF94A3B8" StrokeThickness="1.2"/>
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Button x:Name="BtnClearAll" DockPanel.Dock="Right" Content="{loc:Loc Clipboard.Clear, Default='清空'}" FontSize="11"
                            Foreground="#FFDC2626" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="BtnClearAll_Click" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

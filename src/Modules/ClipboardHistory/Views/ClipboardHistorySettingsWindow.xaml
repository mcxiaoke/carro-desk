<Window x:Class="CarroDesk.Modules.ClipboardHistory.Views.ClipboardHistorySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        Title="{loc:Loc Clipboard.SettingsTitle, Default='剪贴板历史设置'}" Height="404" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <CheckBox x:Name="ChkAutoRecord" Content="{loc:Loc Clipboard.AutoRecord, Default='自动记录剪贴板复制事件'}" IsChecked="True"
                  Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" FontSize="13"/>

        <TextBlock Text="{loc:Loc Clipboard.MaxItems, Default='最大保留条数'}" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" FontSize="13"/>
        <TextBox x:Name="TxtMaxItems" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

        <TextBlock Text="{loc:Loc Clipboard.MaxDays, Default='最大保留天数'}" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" FontSize="13"/>
        <TextBox x:Name="TxtRetentionDays" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

        <TextBlock Text="{loc:Loc Clipboard.MaxPreviewChars, Default='预览最大字符数'}" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" FontSize="13"/>
        <TextBox x:Name="TxtMaxPreviewChars" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

        <TextBlock Text="{loc:Loc Clipboard.Hotkey, Default='唤出快捷键'}" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,0,12,0" FontSize="13"/>
        <TextBox x:Name="TxtHotkey" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

        <CheckBox x:Name="ChkEncryptStorage" Content="{loc:Loc Clipboard.EncryptStorage, Default='加密历史存储（绑定本机当前 Windows 用户）'}"
                  Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,12" FontSize="13"/>

        <Button x:Name="BtnExportHistory" Content="{loc:Loc Clipboard.ExportHistory, Default='导出历史记录...'}"
                Grid.Row="6" Grid.Column="0" HorizontalAlignment="Left" Width="150" Height="30" Margin="0,0,0,12"
                ToolTip="{loc:Loc Clipboard.ExportTooltip, Default='导出为明文 JSON 备份文件，请自行保存到安全位置（如加密云盘）'}"
                Click="OnExportClick"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Grid.Row="8" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Button Content="{loc:Loc Common.Save, Default='保存'}" Width="80" Height="30" IsDefault="True" Margin="0,0,10,0" Click="OnSaveClick"/>
            <Button Content="{loc:Loc Common.Cancel, Default='取消'}" Width="80" Height="30" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="CarroDesk.Modules.ClipboardHistory.Views.ClipboardHistorySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剪贴板历史设置" Height="340" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <CheckBox x:Name="ChkAutoRecord" Content="自动记录剪贴板复制事件" IsChecked="True"
                  Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12" FontSize="13"/>

        <TextBlock Text="最大保留条数" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,0,12,12" FontSize="13"/>
        <TextBox x:Name="TxtMaxItems" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

        <TextBlock Text="最大保留天数" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,0,12,12" FontSize="13"/>
        <TextBox x:Name="TxtRetentionDays" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

        <TextBlock Text="预览最大字符数" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,0,12,12" FontSize="13"/>
        <TextBox x:Name="TxtMaxPreviewChars" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

        <TextBlock Text="唤出快捷键" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,0,12,0" FontSize="13"/>
        <TextBox x:Name="TxtHotkey" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" Height="28" VerticalContentAlignment="Center" Padding="4,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <Button Content="保存" Width="80" Height="30" IsDefault="True" Margin="0,0,10,0" Click="OnSaveClick"/>
            <Button Content="取消" Width="80" Height="30" IsCancel="True" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
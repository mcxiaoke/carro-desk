<Window x:Class="CarroDesk.Modules.AppAutoMute.Views.AppAutoMuteSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="应用后台自动静音设置" Height="700" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF6F7F9"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 现代极简窄滚动条 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#FF999999" CornerRadius="3" Opacity="0.4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片样式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1557B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部说明卡片 -->
        <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🔇 后台智能静音配置" FontSize="16" FontWeight="Bold" Foreground="#FF1E293B"/>
                    <TextBlock Text="在应用失去前台焦点后自动降低或静音，切回前台时平滑恢复声音，避免背景声音干扰。" FontSize="12" Foreground="#FF64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ChkEnabled" Grid.Column="1" Content="启用此功能" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Checked="OnStatusChanged" Unchecked="OnStatusChanged"/>
            </Grid>
        </Border>

        <!-- 核心滚动配置区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,6,0">

                <!-- 卡片 1: 快捷键与延时参数 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="基础参数与热键" FontSize="14" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,12"/>

                        <!-- 全局快捷键 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全局开关热键:" VerticalAlignment="Center" Foreground="#FF475569" FontSize="13"/>
                            <TextBox x:Name="TxtHotkey" Grid.Column="1" Height="30" Padding="8,4" FontSize="13" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                        </Grid>

                        <!-- 切出后台静音延迟 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="切出后台静音延迟:" VerticalAlignment="Center" Foreground="#FF475569" FontSize="13"/>
                            <Slider x:Name="SldMuteDelay" Grid.Column="1" Minimum="100" Maximum="5000" SmallChange="100" LargeChange="500" Value="1000" VerticalAlignment="Center" ValueChanged="OnMuteDelayChanged"/>
                            <TextBlock x:Name="TxtMuteDelayVal" Grid.Column="2" Text="1000 ms" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FF2563EB" FontWeight="SemiBold"/>
                        </Grid>

                        <!-- 切回前台恢复延迟 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="切回前台恢复延迟:" VerticalAlignment="Center" Foreground="#FF475569" FontSize="13"/>
                            <Slider x:Name="SldUnmuteDelay" Grid.Column="1" Minimum="50" Maximum="3000" SmallChange="50" LargeChange="250" Value="500" VerticalAlignment="Center" ValueChanged="OnUnmuteDelayChanged"/>
                            <TextBlock x:Name="TxtUnmuteDelayVal" Grid.Column="2" Text="500 ms" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FF2563EB" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 卡片 2: 目标模式与应用列表 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="静音规则模式" FontSize="14" FontWeight="SemiBold" Foreground="#FF334155" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="RadBlacklist" Content="黑名单模式 (仅静音列表中的程序)" IsChecked="True" Margin="0,0,16,0" FontSize="12" Foreground="#FF475569"/>
                                <RadioButton x:Name="RadWhitelist" Content="白名单模式 (仅保留列表中发声)" FontSize="12" Foreground="#FF475569"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#FFE2E8F0" Margin="0,0,0,12"/>

                        <!-- 快速添加当前发声进程 -->
                        <TextBlock Text="从当前音频/运行程序快速添加:" FontSize="13" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CboRunningApps" Height="30" FontSize="12" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="+ 快速添加" Margin="8,0,0,0" Padding="12,4" Style="{StaticResource SecondaryButtonStyle}" Click="OnAddRunningAppClick"/>
                        </Grid>

                        <!-- 手动输入添加 -->
                        <TextBlock Text="手动输入进程名:" FontSize="13" FontWeight="SemiBold" Foreground="#FF475569" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCustomApp" Height="30" Padding="8,4" FontSize="13" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" KeyDown="OnCustomAppKeyDown"/>
                            <Button Grid.Column="1" Content="📂 浏览 (.exe)..." Margin="8,0,0,0" Padding="12,4" Style="{StaticResource SecondaryButtonStyle}" Click="OnBrowseExeClick" ToolTip="在本地磁盘中选择可执行文件"/>
                            <Button Grid.Column="2" Content="添加进程" Margin="8,0,0,0" Padding="14,4" Style="{StaticResource SecondaryButtonStyle}" Click="OnAddCustomAppClick"/>
                        </Grid>

                        <!-- 已配置目标程序列表 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="当前受控程序列表:" FontSize="13" FontWeight="SemiBold" Foreground="#FF475569" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="清空列表" Background="Transparent" Foreground="#FFDC2626" BorderThickness="0" Cursor="Hand" Padding="6,2" FontSize="12" Click="OnClearAppsClick" ToolTip="清空列表中的所有受控应用"/>
                        </Grid>
                        <ListBox x:Name="LstTargetApps" Height="140" BorderBrush="#E2E8F0" BorderThickness="1" Background="#FFF8FAFC" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔹" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" FontWeight="SemiBold" Foreground="#FF1E293B" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="移除" Background="Transparent" Foreground="#FFDC2626" BorderThickness="0" Cursor="Hand" Padding="8,2" FontSize="12" Tag="{Binding}" Click="OnRemoveAppClick"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部确定与取消操作栏 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="🔊 恢复所有声音 (应急)" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Padding="12,7" Click="OnUnmuteAllClick" ToolTip="立即解除所有受控及活跃程序的静音状态"/>
                    <TextBlock x:Name="TxtNotice" Text="" Foreground="#FF10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存并生效" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="OnSaveClick"/>
                    <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

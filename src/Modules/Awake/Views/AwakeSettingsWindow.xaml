<Window x:Class="CarroDesk.Modules.Awake.Views.AwakeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        Title="保持唤醒 (Awake) 设置" Height="680" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF6F7F9"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 现代极简窄滚动条 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#FF999999" CornerRadius="3" Opacity="0.4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片样式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1557B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部说明卡片 -->
        <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="☕ 保持唤醒 (Awake)" FontSize="15" FontWeight="Bold" Foreground="#FF1E293B"/>
                    <TextBlock Text="阻止计算机进入休眠或息屏，让编译、下载、压制等挂机任务平稳进行" FontSize="12" Foreground="#FF64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#FFF1F5F9" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="已关闭" FontSize="12" FontWeight="SemiBold" Foreground="#FF475569"/>
                </Border>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 1. 工作模式选择卡片 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="工作模式" FontSize="13" FontWeight="Bold" Foreground="#FF334155" Margin="0,0,0,8"/>
                        
                        <RadioButton x:Name="RadioPassive" Content="遵循系统默认电源策略（关闭保持唤醒）" Margin="0,4,0,4" GroupName="AwakeModeGroup"/>
                        <RadioButton x:Name="RadioIndefinite" Content="无限期保持唤醒（直到手动关闭）" Margin="0,4,0,4" GroupName="AwakeModeGroup"/>
                        
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RadioTimed" Content="定时保持唤醒：" VerticalAlignment="Center" GroupName="AwakeModeGroup"/>
                            <TextBox x:Name="TimedMinutesBox" Grid.Column="1" Height="26" Margin="6,0,4,0" VerticalAlignment="Center" TextAlignment="Center" Text="30"/>
                            <TextBlock Grid.Column="2" Text="分钟" VerticalAlignment="Center" Foreground="#FF64748B" FontSize="12"/>
                        </Grid>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RadioUntilTime" Content="保持唤醒至：" VerticalAlignment="Center" GroupName="AwakeModeGroup"/>
                            <TextBox x:Name="UntilTimeBox" Grid.Column="1" Height="26" Margin="6,0,4,0" VerticalAlignment="Center" TextAlignment="Center" Text="18:00"/>
                            <TextBlock Grid.Column="2" Text="(格式 HH:mm，如 18:00)" VerticalAlignment="Center" Foreground="#FF64748B" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. 选项与策略卡片 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="选项与电源策略" FontSize="13" FontWeight="Bold" Foreground="#FF334155" Margin="0,0,0,8"/>

                        <CheckBox x:Name="KeepDisplayOnBox" Content="保持显示器常亮" Margin="0,4,0,2" IsChecked="True"/>
                        <TextBlock Text="未勾选时仅防止系统睡眠，允许显示器按 Windows 电源计划息屏（省电且防 OLED 烧屏）" FontSize="11" Foreground="#FF94A3B8" Margin="22,0,0,8" TextWrapping="Wrap"/>

                        <CheckBox x:Name="DisableOnBatteryBox" Content="使用笔记本电池供电时自动挂起保持唤醒" Margin="0,4,0,2" IsChecked="True"/>
                        <TextBlock Text="断开交流电源时自动挂起，防止放进背包发热或意外耗尽电量" FontSize="11" Foreground="#FF94A3B8" Margin="22,0,0,6" TextWrapping="Wrap"/>

                        <Grid Margin="22,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="低电量保护阈值：" VerticalAlignment="Center" FontSize="12" Foreground="#FF475569"/>
                            <TextBox x:Name="BatteryThresholdBox" Grid.Column="1" Height="24" Margin="6,0,4,0" TextAlignment="Center" Text="20"/>
                            <TextBlock Grid.Column="2" Text="% (低于此值强制退出保持唤醒)" VerticalAlignment="Center" Foreground="#FF64748B" FontSize="11"/>
                        </Grid>

                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="全局快速切换热键：" VerticalAlignment="Center" FontSize="12" Foreground="#FF475569"/>
                            <TextBox x:Name="HotkeyBox" Grid.Column="1" Height="26" Margin="8,0,0,0" Text="Win+Shift+W" VerticalAlignment="Center" Padding="4,2"/>
                            <TextBlock Grid.Column="2" Text="(一键在开启与关闭之间切换)" VerticalAlignment="Center" Foreground="#FF94A3B8" FontSize="11" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. 智能目标进程联动卡片 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="智能进程联动（检测到运行时自动保持唤醒）" FontSize="13" FontWeight="Bold" Foreground="#FF334155" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ProcessLinkEnabledBox" Grid.Column="1" Content="启用" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" IsChecked="True" Checked="OnProcessLinkEnabledChanged" Unchecked="OnProcessLinkEnabledChanged" ToolTip="总开关：关闭后不再检测目标进程，名单与缓冲设置保留"/>
                        </Grid>
                        <TextBlock Text="当名单中的程序在运行时自动进入保持唤醒；全部退出后自动恢复" FontSize="11" Foreground="#FF94A3B8" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <StackPanel x:Name="ProcessLinkPanel">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ProcessInputBox" Height="26" Padding="6,2" ToolTip="输入进程名，如 devenv, blender, ffmpeg"/>
                                <Button Content="📂 浏览 (.exe)..." Grid.Column="1" Height="26" Margin="4,0,0,0" Padding="8,0" Click="OnBrowseExeProcessClick" ToolTip="在本地磁盘中选择可执行文件"/>
                                <Button Content="从运行进程中选取..." Grid.Column="2" Height="26" Margin="4,0,0,0" Padding="8,0" Click="OnPickRunningProcessClick"/>
                                <Button Content="添加" Grid.Column="3" Height="26" Margin="4,0,0,0" Padding="12,0" Click="OnAddProcessClick"/>
                                <Button Content="删除" Grid.Column="4" Height="26" Margin="4,0,0,0" Padding="12,0" Click="OnDeleteProcessClick"/>
                            </Grid>

                            <ListBox x:Name="ProcessListBox" Height="90" SelectionMode="Single">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="删除所选" Click="OnDeleteProcessClick"/>
                                        <MenuItem Header="清空列表" Click="OnClearProcessesClick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="退出缓冲时间：" VerticalAlignment="Center" FontSize="12" Foreground="#FF475569"/>
                                <TextBox x:Name="ExitDelayBox" Grid.Column="1" Height="24" Margin="6,0,4,0" TextAlignment="Center" Text="120"/>
                                <TextBlock Grid.Column="2" Text="秒 (进程退出后延迟恢复的缓冲时间，设为 0 则立即恢复)" VerticalAlignment="Center" Foreground="#FF64748B" FontSize="11" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="ProcessLinkDisabledHint" Text="智能进程联动已停用，名单与缓冲设置仍然保留；勾选上方“启用”即可恢复。" FontSize="11" Foreground="#FFB45309" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作按钮 -->
        <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
            <DockPanel LastChildFill="False">
                <Button Content="恢复默认" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Left" Click="OnResetDefaultsClick"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="保存并应用" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="OnSaveApplyClick"/>
                    <Button Content="关闭" Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

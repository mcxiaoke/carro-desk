<Window x:Class="CarroDesk.Modules.MonitorProfile.Views.MonitorProfileSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="显示器亮度与情境模式设置" Height="680" Width="720"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF6F7F9"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 基础转换器 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- 现代极简窄滚动条 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#FF999999" CornerRadius="3" Opacity="0.4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片样式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1557B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部提示横幅 -->
        <Border Grid.Row="0" Background="#FFEBF2FB" BorderBrush="#FFD3E3F8" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock Text="🖥️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="显示器亮度与情境模式 (DDC/CI &amp; WMI)" FontWeight="Bold" FontSize="13" Foreground="#FF1A73E8"/>
                    <TextBlock x:Name="TxtHardwareInfo" Text="正在检测显示器..." FontSize="11" Foreground="#FF555555" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主工作区分栏：左侧模式列表，右侧时间设置与高级选项 -->
        <Grid Grid.Row="1" Margin="14,10,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：模式列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="情境模式列表" FontWeight="Bold" FontSize="13" Foreground="#FF1F2937" Margin="2,2,0,8"/>

                    <ListBox x:Name="LstModes" Grid.Row="1" BorderThickness="1" BorderBrush="#FFE5E7EB" SelectionChanged="LstModes_SelectionChanged">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="设为当前模式" Click="BtnSetActive_Click"/>
                                <MenuItem Header="重命名模式..." Click="BtnRenameMode_Click"/>
                                <Separator/>
                                <MenuItem Header="删除模式" Click="BtnDeleteMode_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Text="● 当前" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}" Foreground="#FF1A73E8" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="BtnSetActive" Content="设为当前模式" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,6" Click="BtnSetActive_Click"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAddMode" Content="新建" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,2,0" Click="BtnAddMode_Click"/>
                            <Button x:Name="BtnRenameMode" Grid.Column="1" Content="重命名" Style="{StaticResource SecondaryButtonStyle}" Margin="2,0,2,0" Click="BtnRenameMode_Click"/>
                            <Button x:Name="BtnDeleteMode" Grid.Column="2" Content="删除" Style="{StaticResource SecondaryButtonStyle}" Margin="2,0,0,0" Click="BtnDeleteMode_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：时间段与设置详情（支持滚动） -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 卡片 1：时间表设置 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="TxtCurrentModeTitle" Text="模式时间段设置" FontWeight="Bold" FontSize="13" Foreground="#FF1F2937"/>
                                <TextBlock Text="按时间自动应用亮度和对比度" FontSize="11" Foreground="#FF6B7280" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>

                            <DataGrid x:Name="GridTimeSettings" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      BorderThickness="1" BorderBrush="#FFE5E7EB" Background="White" Height="160"
                                      RowHeight="28" SelectionMode="Single"
                                      SelectionChanged="GridTimeSettings_SelectionChanged"
                                      MouseDoubleClick="GridTimeSettings_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间点" Binding="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90"/>
                                    <DataGridTextColumn Header="亮度 (0-100)" Binding="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="100"/>
                                    <DataGridTextColumn Header="对比度 (0-100)" Binding="{Binding Contrast, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="100"/>
                                    <DataGridTemplateColumn Header="操作" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" Style="{StaticResource SecondaryButtonStyle}" Padding="6,1" FontSize="11" Click="BtnDeleteTimeSetting_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 添加/修改时间点输入栏 -->
                            <Border Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="时间:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#FF4B5563"/>
                                    <TextBox x:Name="TxtNewTime" Grid.Column="1" Text="12:00" Height="24" VerticalContentAlignment="Center" Padding="4,1"/>

                                    <TextBlock Grid.Column="2" Text="亮度:" VerticalAlignment="Center" Margin="6,0,4,0" Foreground="#FF4B5563"/>
                                    <TextBox x:Name="TxtNewBrightness" Grid.Column="3" Text="60" Height="24" VerticalContentAlignment="Center" Padding="4,1"/>

                                    <TextBlock Grid.Column="4" Text="对比度:" VerticalAlignment="Center" Margin="6,0,4,0" Foreground="#FF4B5563"/>
                                    <TextBox x:Name="TxtNewContrast" Grid.Column="5" Text="70" Height="24" VerticalContentAlignment="Center" Padding="4,1"/>

                                    <Button x:Name="BtnUpdateTimeSetting" Grid.Column="7" Content="更新选中" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Click="BtnUpdateTimeSetting_Click" ToolTip="更新当前选中的时间点"/>
                                    <Button Grid.Column="8" Content="+ 添加" Style="{StaticResource SecondaryButtonStyle}" Click="BtnAddTimeSetting_Click" ToolTip="添加为新时间点"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 2：自动化与高级选项 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="自动化与调节控制" FontWeight="Bold" FontSize="13" Foreground="#FF1F2937" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkAutoSchedule" Content="启用时间计划自动切换（每分钟检测当前时间并自动调节）" Margin="0,0,0,8"/>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="快捷键微调步长:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#FF4B5563"/>
                                <ComboBox x:Name="CmbBrightnessStep" Grid.Column="1" Height="26">
                                    <ComboBoxItem Content="1%" Tag="1"/>
                                    <ComboBoxItem Content="3%" Tag="3"/>
                                    <ComboBoxItem Content="5% (推荐)" Tag="5" IsSelected="True"/>
                                    <ComboBoxItem Content="10%" Tag="10"/>
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="单次按增减快捷键变化的亮度幅度" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF9CA3AF" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 卡片 3：全局快捷键 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="全局快捷键 (可在任意窗口直接触发)" FontWeight="Bold" FontSize="13" Foreground="#FF1F2937" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="切换日常模式:" VerticalAlignment="Center" Foreground="#FF4B5563" Margin="0,4"/>
                                <TextBox x:Name="TxtHkDaily" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Text="切换游戏模式:" VerticalAlignment="Center" Foreground="#FF4B5563" Margin="0,4"/>
                                <TextBox x:Name="TxtHkGame" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Text="切换夜间模式:" VerticalAlignment="Center" Foreground="#FF4B5563" Margin="0,4"/>
                                <TextBox x:Name="TxtHkNight" Grid.Row="2" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Column="3" Text="增加亮度(+):" VerticalAlignment="Center" Foreground="#FF4B5563" Margin="0,4"/>
                                <TextBox x:Name="TxtHkUp" Grid.Column="4" Height="24" VerticalContentAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="3" Text="降低亮度(-):" VerticalAlignment="Center" Foreground="#FF4B5563" Margin="0,4"/>
                                <TextBox x:Name="TxtHkDown" Grid.Row="1" Grid.Column="4" Height="24" VerticalContentAlignment="Center" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="3" Text="手动刷新配置:" VerticalAlignment="Center" Foreground="#FF4B5563" Margin="0,4"/>
                                <TextBox x:Name="TxtHkRefresh" Grid.Row="2" Grid.Column="4" Height="24" VerticalContentAlignment="Center" Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部固定操作栏 -->
        <Border Grid.Row="2" Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel LastChildFill="False">
                <Button Content="恢复默认配置" Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Left" Click="BtnResetDefaults_Click"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="立即应用测试" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="BtnTestApply_Click"/>
                    <Button Content="保存并应用" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="BtnSave_Click"/>
                    <Button Content="关闭" Style="{StaticResource SecondaryButtonStyle}" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="CarroDesk.Views.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        Cursor="None">
    <Border x:Name="RootBorder" Background="#FF0B0F14" Opacity="0">
        <Grid>
            <!-- 主显示器解锁面板 -->
            <StackPanel x:Name="InputPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <!-- 大时钟与日期 -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                    <TextBlock x:Name="LargeClockText" Text="12:00:00" FontSize="58" FontWeight="SemiBold"
                               Foreground="#FFF0F3F6" HorizontalAlignment="Center" FontFamily="Segoe UI, Microsoft YaHei UI"/>
                    <TextBlock x:Name="DateText" Text="--" FontSize="16" Foreground="#FF8B949E"
                               HorizontalAlignment="Center" Margin="0,6,0,0" FontFamily="Segoe UI, Microsoft YaHei UI"/>
                </StackPanel>

                <!-- PIN 输入卡片容器（含平滑悬浮阴影与抖动变换） -->
                <Border x:Name="InputCard" Background="#E6161B22" CornerRadius="12" BorderBrush="#FF30363D" BorderThickness="1"
                        Padding="32,26" Width="360">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.65"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="CardTransform" X="0" Y="0"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <!-- 锁屏盾牌徽标 -->
                        <Border Width="40" Height="40" CornerRadius="20" Background="#1C2128" BorderBrush="#FF30363D" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Data="M12 2a4 4 0 0 0-4 4v2H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V6a4 4 0 0 0-4-4zm2 6H10V6a2 2 0 1 1 4 0v2z"
                                  Fill="#58A6FF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="{loc:Loc Lock.Title}" FontSize="18" FontWeight="Bold" Foreground="#FFF0F3F6" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Lock.InputPinHint}" FontSize="12" Foreground="#FF8B949E" HorizontalAlignment="Center" Margin="0,3,0,16"/>

                        <!-- 圆角密码输入框容器 -->
                        <Border CornerRadius="6" Background="#FF0D1117" BorderBrush="#FF30363D" BorderThickness="1" Height="42">
<PasswordBox x:Name="PinBox" FontSize="20" MaxLength="16"
                                             HorizontalContentAlignment="Center" Background="Transparent" Foreground="White"
                                             BorderThickness="0" Padding="8,6"
                                             CaretBrush="#FFF0F3F6" Cursor="IBeam"/>
                        </Border>

                        <!-- 键盘状态提示（CapsLock / NumLock） -->
                        <TextBlock x:Name="KeyHintText" FontSize="11" Foreground="#FFE3B341" HorizontalAlignment="Center"
                                   Margin="0,8,0,0" Visibility="Collapsed" Text="⚠️ 大写锁定 (Caps Lock) 已开启"/>

                        <!-- 现代解锁强调按钮 -->
                        <Button x:Name="UnlockButton" Content="{loc:Loc Lock.Unlock}" Height="40" Margin="0,16,0,0"
                                FontSize="15" FontWeight="SemiBold" Foreground="White" Cursor="Hand" Click="OnUnlockClick">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="btnBorder" Background="#FF1F6FEB" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#FF388BFD"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="btnBorder" Property="Background" Value="#FF1158C7"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="MessageText" FontSize="12" Foreground="#FFF85149" HorizontalAlignment="Center"
                                   Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" MinHeight="16"/>

                        <!-- 应急切换至系统原生锁屏逃生通道 -->
                        <Button x:Name="WindowsLockEscapeButton" Content="🔒 切换至 Windows 锁屏" Height="26" Margin="0,10,0,0"
                                FontSize="11" Foreground="#8B949E" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="OnWindowsLockEscapeClick" ToolTip="如果无法输入或忘记PIN，可安全降级到系统登录界面锁屏"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 副显示器遮罩时钟面板（高对比度优雅展示） -->
            <StackPanel x:Name="CoverPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="#161B22" BorderBrush="#FF30363D" BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Path Data="M12 2a4 4 0 0 0-4 4v2H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V6a4 4 0 0 0-4-4zm2 6H10V6a2 2 0 1 1 4 0v2z"
                          Fill="#8B949E" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="CoverLargeClockText" Text="12:00:00" FontSize="60" FontWeight="SemiBold"
                           Foreground="#FFC9D1D9" HorizontalAlignment="Center" FontFamily="Segoe UI, Microsoft YaHei UI"/>
                <TextBlock x:Name="CoverDateText" Text="--" FontSize="17" Foreground="#FF8B949E"
                           HorizontalAlignment="Center" Margin="0,8,0,0" FontFamily="Segoe UI, Microsoft YaHei UI"/>
                <TextBlock Text="{loc:Loc Lock.Title}" FontSize="18" FontWeight="SemiBold" Foreground="#FF8B949E"
                           HorizontalAlignment="Center" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

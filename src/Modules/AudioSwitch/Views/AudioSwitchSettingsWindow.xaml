<Window x:Class="CarroDesk.Modules.AudioSwitch.Views.AudioSwitchSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音频输出设备切换设置" Height="700" Width="660" MinWidth="640" MinHeight="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF6F7F9"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 现代极简窄滚动条 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#FF999999" CornerRadius="3" Opacity="0.4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片样式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 主按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1557B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderBrush" Value="#FFD1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小按钮样式 -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF1F5F9"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部说明与状态卡片 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="🎧 音频输出设备切换 (AudioSwitch)" FontSize="15" FontWeight="Bold" Foreground="#FF1E293B"/>
                    <TextBlock Text="配置全局快捷键、耳机/扬声器关键字，以及排除显示器无声 HDMI 等候选端点" FontSize="12" Foreground="#FF64748B" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" x:Name="StatusBadge" Background="#FFDBEAFE" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeText" Text="当前默认: 检测中..." FontSize="12" FontWeight="SemiBold" Foreground="#FF1E40AF"/>
                </Border>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- 卡片 1: 核心设置与快捷键 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="基础与快捷键设置" FontSize="14" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkEnabled" Content="启用音频输出设备快捷切换" IsChecked="True" FontSize="13" Foreground="#FF1E293B" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷切换热键:" VerticalAlignment="Center" Foreground="#FF475569" FontSize="13"/>
                            <TextBox x:Name="TxtHotkey" Grid.Column="1" Height="28" Padding="6,2" FontSize="13" Text="Ctrl+`" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                            <TextBlock Grid.Column="2" Text="(例如: Ctrl+`, Alt+F11, Win+Ctrl+A)" VerticalAlignment="Center" Foreground="#FF94A3B8" FontSize="12" Margin="8,0,0,0"/>
                        </Grid>

                        <CheckBox x:Name="ChkPlaySound" Content="切换成功时播放系统提示音" IsChecked="True" FontSize="13" Foreground="#FF1E293B"/>
                    </StackPanel>
                </Border>

                <!-- 卡片 2: 目标设备匹配关键字 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="设备分类匹配关键字" FontSize="14" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,0,0,4"/>
                        <TextBlock Text="按快捷键切换时，优先在包含扬声器关键字与耳机关键字的设备之间二元往复切换：" FontSize="12" Foreground="#FF64748B" Margin="0,0,0,10"/>

                        <!-- 扬声器关键字 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔊 扬声器关键字:" VerticalAlignment="Center" Foreground="#FF475569" FontSize="13"/>
                            <TextBox x:Name="TxtSpeakerPattern" Grid.Column="1" Height="28" Padding="6,2" FontSize="13" Text="扬声器" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                            <Button Grid.Column="2" Content="填入选中设备名" Margin="8,0,0,0" Style="{StaticResource SmallButtonStyle}" Click="OnUseSelectedAsSpeakerClick" ToolTip="将列表中选中的设备名称填入扬声器关键字"/>
                            <TextBlock Grid.Column="3" Text="(默认: 扬声器 / Speakers)" VerticalAlignment="Center" Foreground="#FF94A3B8" FontSize="11" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- 耳机关键字 -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🎧 耳机关键字:" VerticalAlignment="Center" Foreground="#FF475569" FontSize="13"/>
                            <TextBox x:Name="TxtHeadphonePattern" Grid.Column="1" Height="28" Padding="6,2" FontSize="13" Text="耳机" VerticalContentAlignment="Center" BorderBrush="#CBD5E1"/>
                            <Button Grid.Column="2" Content="填入选中设备名" Margin="8,0,0,0" Style="{StaticResource SmallButtonStyle}" Click="OnUseSelectedAsHeadphoneClick" ToolTip="将列表中选中的设备名称填入耳机关键字"/>
                            <TextBlock Grid.Column="3" Text="(默认: 耳机 / Headphones)" VerticalAlignment="Center" Foreground="#FF94A3B8" FontSize="11" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 卡片 3: 系统播放设备与排除列表 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtDeviceCount" Text="系统音频播放设备与排除策略:" FontSize="14" FontWeight="SemiBold" Foreground="#FF334155" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="🔄 刷新设备" Style="{StaticResource SmallButtonStyle}" Margin="0,0,8,0" Click="OnRefreshDevicesClick" ToolTip="重新检测系统当前活跃音频端点"/>
                            <Button Grid.Column="2" Content="清空所有排除" Style="{StaticResource SmallButtonStyle}" Click="OnClearExclusionsClick" ToolTip="取消所有排除勾选"/>
                        </Grid>
                        <TextBlock Text="勾选【排除轮询】的设备在快捷键切换时将被直接跳过（解决切至无声 HDMI 显示器的问题）。双击设备可立即设为默认。" FontSize="11" Foreground="#FF64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <ListBox x:Name="LstDevices" MinHeight="160" MaxHeight="240" BorderBrush="#E2E8F0" BorderThickness="1" Background="#FFF8FAFC" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnDeviceMouseDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="设为当前默认输出" Click="OnSetDefaultMenuItemClick"/>
                                    <MenuItem Header="切换排除状态" Click="OnToggleExclusionMenuItemClick"/>
                                    <Separator/>
                                    <MenuItem Header="设为扬声器关键字" Click="OnUseSelectedAsSpeakerClick"/>
                                    <MenuItem Header="设为耳机关键字" Click="OnUseSelectedAsHeadphoneClick"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 排除勾选 -->
                                        <CheckBox IsChecked="{Binding IsExcluded, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="勾选以排除此设备，快捷切换时将跳过"/>

                                        <!-- 图标 -->
                                        <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- 设备名称与ID -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FF1E293B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#FF94A3B8" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- 状态徽章 -->
                                        <Border Grid.Column="3" CornerRadius="4" Padding="6,2" Margin="8,0" VerticalAlignment="Center"
                                                Background="{Binding BadgeBackground}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                                        </Border>

                                        <!-- 快捷设为默认按钮 -->
                                        <Button Grid.Column="4" Content="设为默认" Style="{StaticResource SmallButtonStyle}" VerticalAlignment="Center" Tag="{Binding}" Click="OnSetAsDefaultClick" ToolTip="立即将此设备设为系统默认音频输出"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部确定与取消操作栏 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="⚡ 快捷测试切换" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6" Click="OnTestToggleClick" ToolTip="立即模拟触发一次音频切换"/>
                    <Button Content="恢复默认" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0" Padding="10,6" Click="OnResetDefaultsClick" ToolTip="恢复默认设置"/>
                    <TextBlock x:Name="TxtNotice" Text="" Foreground="#FF10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="保存并生效" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0" Click="OnSaveClick"/>
                    <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="CarroDesk.Modules.TaskScheduler.Views.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        Title="自动化任务管理 - CarroDesk" Height="620" Width="980" MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF8FAFC">
    <Window.Resources>
        <!-- 现代极简窄滚动条 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#FF94A3B8" CornerRadius="3" Opacity="0.4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 工具栏按钮通用样式 -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1E293B"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作强调按钮 -->
        <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险操作按钮（删除） -->
        <Style x:Key="DangerBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FFDC2626"/>
            <Setter Property="BorderBrush" Value="#FFFCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFEF2F2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFEF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFEE2E2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行右键上下文菜单 -->
        <ContextMenu x:Key="TaskRowContextMenu">
            <MenuItem Header="▶ 立即运行" Click="OnRunClick"/>
            <MenuItem Header="⏹ 停止运行" Click="OnStopClick"/>
            <MenuItem Header="🔄 重启任务" Click="OnRestartClick"/>
            <Separator/>
            <MenuItem x:Name="MenuToggleEnabled" Header="⚡ 启用 / 禁用任务" Click="OnToggleEnabledClick"/>
            <MenuItem Header="✏️ 编辑任务..." FontWeight="Bold" Click="OnEditClick"/>
            <MenuItem Header="📋 复制任务" Click="OnDuplicateClick"/>
            <Separator/>
            <MenuItem Header="📄 查看任务日志" Click="OnViewLogClick"/>
            <MenuItem Header="📂 打开日志目录" Click="OnOpenLogDirClick"/>
            <Separator/>
            <MenuItem Header="🗑️ 删除任务" Foreground="#FFDC2626" Click="OnDeleteClick"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏卡片 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="True">
                <!-- 左侧动作按钮组 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="＋ 新建任务" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="OnNewTaskClick"/>
                    <Button x:Name="ToolbarRunBtn" Content="▶ 运行" Margin="0,0,6,0" Click="OnRunClick" ToolTip="立即手动执行选中的任务"/>
                    <Button x:Name="ToolbarStopBtn" Content="⏹ 停止" Margin="0,0,6,0" Click="OnStopClick" ToolTip="终止选定任务当前运行中的实例"/>
                    <Button x:Name="ToolbarRestartBtn" Content="🔄 重启" Margin="0,0,6,0" Click="OnRestartClick" ToolTip="终止后立即重新拉起该任务"/>
                    <Button x:Name="ToolbarEditBtn" Content="✏️ 编辑" Margin="0,0,6,0" Click="OnEditClick" ToolTip="打开任务编辑面板 (或双击列表行)"/>
                    <Button x:Name="ToolbarLogBtn" Content="📄 日志" Margin="0,0,6,0" Click="OnViewLogClick" ToolTip="打开该任务运行日志"/>
                    <Button x:Name="ToolbarDeleteBtn" Content="🗑️ 删除" Style="{StaticResource DangerBtn}" Margin="0,0,8,0" Click="OnDeleteClick" ToolTip="删除选中的任务"/>
                </StackPanel>

                <!-- 右侧搜索框与刷新 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Grid Width="200" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox" Height="30" Padding="8,4,24,4" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="🔍 搜索任务..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF94A3B8" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Content="⟳ 刷新" Height="30" Padding="10,0" Click="OnRefreshClick" ToolTip="重新加载任务配置与运行时状态"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 中部任务大盘列表卡片 -->
        <Border Grid.Row="1" Background="White" Margin="16,14,16,12" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1">
            <Grid>
                <ListView x:Name="TaskListView" BorderThickness="0" Background="Transparent"
                          SelectionMode="Single"
                          SelectionChanged="TaskListView_SelectionChanged"
                          MouseDoubleClick="TaskListView_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="ContextMenu" Value="{StaticResource TaskRowContextMenu}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#FFF1F5F9" BorderThickness="0,0,0,1" Padding="4,4">
                                            <GridViewRowPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFF8FAFC"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFEFF6FF"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFBFDBFE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.View>
                        <GridView>
                            <!-- 列 1: 运行态 -->
                            <GridViewColumn Header="运行状态" Width="185">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="{Binding StateDotBrush}" VerticalAlignment="Center" Margin="2,0,7,0"/>
                                            <TextBlock Text="{Binding StateDisplayText}" Foreground="{Binding StateTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 2: 任务名称 -->
                            <GridViewColumn Header="任务名称" Width="145">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FF0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 3: 配置启用状态 (防误触徽标) -->
                            <GridViewColumn Header="启用" Width="68">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding EnabledBadgeBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="通过右键菜单可切换【启用/禁用】">
                                            <TextBlock Text="{Binding EnabledBadgeText}" Foreground="{Binding EnabledBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 4: 触发条件徽标 -->
                            <GridViewColumn Header="触发方式" Width="135">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TriggerBadgeBg}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TriggerSummary}" Foreground="{Binding TriggerBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 5: 模式 -->
                            <GridViewColumn Header="模式" Width="75">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModeDisplayText}" Foreground="#FF475569" FontSize="11" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 6: 执行命令 -->
                            <GridViewColumn Header="执行动作" Width="195">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActionSummary}" Foreground="#FF64748B" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ActionSummary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 7: 最近运行结果 -->
                            <GridViewColumn Header="最近结果" Width="145">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OutcomeDisplayText}" Foreground="#FF64748B" FontSize="11" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="📋 暂无任务" FontSize="16" FontWeight="Bold" Foreground="#FF94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="点击上方【＋ 新建任务】创建您的第一个自动化计划任务" FontSize="12" Foreground="#FFCBD5E1" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态栏卡片 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <!-- 左侧总开关与统计 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <CheckBox x:Name="GlobalEnabledBox" Content="启用自动化任务调度总开关" VerticalAlignment="Center" FontWeight="SemiBold" Click="OnGlobalEnabledClick" ToolTip="关闭后所有自动化任务将暂停触发"/>
                    <Separator Width="1" Height="16" Margin="14,0,14,0" Background="#FFE2E8F0"/>
                    <TextBlock x:Name="StatsSummaryText" Text="共 0 个任务 · 0 个运行中 · 0 个已禁用" Foreground="#FF64748B" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧关闭按钮 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="关闭" Height="30" Padding="16,0" IsCancel="True" Click="OnCloseClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

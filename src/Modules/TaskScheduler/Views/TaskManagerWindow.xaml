<Window x:Class="CarroDesk.Modules.TaskScheduler.Views.TaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        Title="{loc:Loc Tasks.MgrAutomatedTasksCarroDesk, Default='自动化任务管理 - CarroDesk'}" Height="620" Width="1150" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF8FAFC">
    <Window.Resources>
        <!-- 现代极简窄滚动条 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#FF94A3B8" CornerRadius="3" Opacity="0.4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 工具栏按钮通用样式 -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1E293B"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作强调按钮 -->
        <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险操作按钮（删除） -->
        <Style x:Key="DangerBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FFDC2626"/>
            <Setter Property="BorderBrush" Value="#FFFCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFEF2F2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFEF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFFEE2E2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行右键上下文菜单 -->
        <ContextMenu x:Key="TaskRowContextMenu">
            <MenuItem Header="{loc:Loc Tasks.MgrRunNow, Default='▶ 立即运行'}" Click="OnRunClick"/>
            <MenuItem Header="{loc:Loc Tasks.MgrStopRun, Default='⏹ 停止运行'}" Click="OnStopClick"/>
            <MenuItem Header="{loc:Loc Tasks.MgrRestartTask, Default='🔄 重启任务'}" Click="OnRestartClick"/>
            <Separator/>
            <MenuItem x:Name="MenuToggleEnabled" Header="{loc:Loc Tasks.MgrEnableDisableTask, Default='⚡ 启用 / 禁用任务'}" Click="OnToggleEnabledClick"/>
            <MenuItem Header="{loc:Loc Tasks.MgrEditTask, Default='✏️ 编辑任务...'}" FontWeight="Bold" Click="OnEditClick"/>
            <MenuItem Header="{loc:Loc Tasks.MgrDuplicateTask, Default='📋 复制任务'}" Click="OnDuplicateClick"/>
            <Separator/>
            <MenuItem Header="{loc:Loc Tasks.MgrViewTaskLog, Default='📄 查看任务日志'}" Click="OnViewLogClick"/>
            <MenuItem Header="{loc:Loc Tasks.MgrOpenLogFolder, Default='📂 打开日志目录'}" Click="OnOpenLogDirClick"/>
            <Separator/>
            <MenuItem Header="{loc:Loc Tasks.MgrDeleteTask, Default='🗑️ 删除任务'}" Foreground="#FFDC2626" Click="OnDeleteClick"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏卡片 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel>
            <!-- 加载异常横幅：只在 tasks.json 有问题时出现，防止整表覆盖用户数据 -->
            <Border x:Name="LoadIssueBanner" Visibility="Collapsed" Background="#FFFEF3C7"
                    BorderBrush="#FFF59E0B" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                <TextBlock x:Name="LoadIssueText" Text="" Foreground="#FF92400E" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Border>
            <DockPanel LastChildFill="True">
                <!-- 左侧动作按钮组 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="{loc:Loc Tasks.MgrNewTask, Default='＋ 新建任务'}" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="OnNewTaskClick"/>
                    <Button x:Name="ToolbarRunBtn" Content="{loc:Loc Tasks.MgrRun, Default='▶ 运行'}" Margin="0,0,6,0" Click="OnRunClick" ToolTip="{loc:Loc Tasks.MgrManuallyRunTheSelected, Default='立即手动执行选中的任务'}"/>
                    <Button x:Name="ToolbarStopBtn" Content="{loc:Loc Tasks.MgrStop, Default='⏹ 停止'}" Margin="0,0,6,0" Click="OnStopClick" ToolTip="{loc:Loc Tasks.MgrStopTheRunningInstance, Default='终止选定任务当前运行中的实例'}"/>
                    <Button x:Name="ToolbarRestartBtn" Content="{loc:Loc Tasks.MgrRestart, Default='🔄 重启'}" Margin="0,0,6,0" Click="OnRestartClick" ToolTip="{loc:Loc Tasks.MgrStopAndImmediatelyStart, Default='终止后立即重新拉起该任务'}"/>
                    <Button x:Name="ToolbarEditBtn" Content="{loc:Loc Tasks.MgrEdit, Default='✏️ 编辑'}" Margin="0,0,6,0" Click="OnEditClick" ToolTip="{loc:Loc Tasks.MgrOpenTaskEditorOr, Default='打开任务编辑面板 (或双击列表行)'}"/>
                    <Button x:Name="ToolbarLogBtn" Content="{loc:Loc Tasks.MgrLog, Default='📄 日志'}" Margin="0,0,6,0" Click="OnViewLogClick" ToolTip="{loc:Loc Tasks.MgrOpenTheRunLog, Default='打开该任务运行日志'}"/>
                    <Button x:Name="ToolbarDeleteBtn" Content="{loc:Loc Tasks.MgrDelete, Default='🗑️ 删除'}" Style="{StaticResource DangerBtn}" Margin="0,0,8,0" Click="OnDeleteClick" ToolTip="{loc:Loc Tasks.MgrDeleteTheSelectedTask, Default='删除选中的任务'}"/>
                </StackPanel>

                <!-- 右侧搜索框与刷新 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Grid Width="200" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox" Height="30" Padding="8,4,24,4" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="{loc:Loc Tasks.MgrSearchTasks, Default='🔍 搜索任务...'}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF94A3B8" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Content="{loc:Loc Tasks.MgrRefresh, Default='⟳ 刷新'}" Height="30" Padding="10,0" Click="OnRefreshClick" ToolTip="{loc:Loc Tasks.MgrReloadTaskConfigurationAnd, Default='重新加载任务配置与运行时状态'}"/>
                </StackPanel>
            </DockPanel>
            </StackPanel>
        </Border>

        <!-- 中部任务大盘列表卡片 -->
        <Border Grid.Row="1" Background="White" Margin="16,14,16,12" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1">
            <Grid>
                <ListView x:Name="TaskListView" BorderThickness="0" Background="Transparent"
                          SelectionMode="Single"
                          SelectionChanged="TaskListView_SelectionChanged"
                          MouseDoubleClick="TaskListView_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}">
                            <Setter Property="ContextMenu" Value="{StaticResource TaskRowContextMenu}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#FFF1F5F9" BorderThickness="0,0,0,1" Padding="4,4">
                                            <GridViewRowPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFF8FAFC"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FFEFF6FF"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFBFDBFE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.View>
                        <GridView>
                            <!-- 列 1: 运行状态（纯状态文字，PID 与时长各自独立成列） -->
                            <GridViewColumn Header="{loc:Loc Tasks.MgrState, Default='运行状态'}" Width="92">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" Fill="{Binding StateDotBrush}" VerticalAlignment="Center" Margin="2,0,7,0"/>
                                            <TextBlock Text="{Binding StateDisplayText}" Foreground="{Binding StateTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 2: 进程 PID -->
                            <GridViewColumn Header="PID" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PidDisplayText}" Foreground="{Binding PidTextBrush}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 3: 已运行时长（人类可读：秒 / 分 / 小时 / 天） -->
                            <GridViewColumn Header="{loc:Loc Tasks.MgrElapsed, Default='已运行'}" Width="96">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DurationDisplayText}" Foreground="#FF475569" FontSize="11" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 4: 任务名称 -->
                            <GridViewColumn Header="{loc:Loc Tasks.MgrTaskName, Default='任务名称'}" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FF0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 5: 配置启用状态（是/否 徽标，防误触） -->
                            <GridViewColumn Header="{loc:Loc Tasks.MgrEnabled, Default='启用'}" Width="56">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding EnabledBadgeBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{loc:Loc Tasks.MgrUseTheRightClick, Default='通过右键菜单可切换【启用/禁用】'}">
                                            <TextBlock Text="{Binding EnabledBadgeText}" Foreground="{Binding EnabledBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 6: 常驻（原“模式”列，改为 是/否） -->
                            <GridViewColumn Header="{loc:Loc Tasks.MgrResident, Default='常驻'}" Width="56">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResidentText}" Foreground="{Binding ResidentTextBrush}" FontSize="11" VerticalAlignment="Center" ToolTip="{loc:Loc Tasks.MgrYesResidentWithAuto, Default='是 = 常驻守护（进程退出自动重启）；否 = 单次运行'}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 7: 触发条件徽标 -->
                            <GridViewColumn Header="{loc:Loc Tasks.MgrTrigger, Default='触发方式'}" Width="88">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding TriggerBadgeBg}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding TriggerSummary}">
                                            <TextBlock Text="{Binding TriggerShortText}" TextTrimming="CharacterEllipsis" Foreground="{Binding TriggerBadgeFg}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 8: 内存占用（仅在窗口可见时采样，见窗口后台采样器） -->
                            <GridViewColumn Width="92">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{loc:Loc Tasks.MgrMemory, Default='内存占用'}" ToolTip="{loc:Loc Tasks.MgrProcessWorkingSetRAM, Default='进程物理工作集（RAM）。仅在任务管理窗口打开且未最小化时采样，后台常驻不读取。'}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MemoryDisplayText}" Foreground="{Binding MemoryTextBrush}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 9: 执行命令 -->
                            <GridViewColumn Header="{loc:Loc Tasks.MgrAction, Default='执行动作'}" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActionSummary}" Foreground="#FF64748B" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding ActionSummary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 10: 最近运行时间（上一次真正启动的时刻，持久化） -->
                            <GridViewColumn Header="{loc:Loc Tasks.MgrLastRun, Default='最近运行'}" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastRunDisplayText}" Foreground="#FF64748B" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding LastRunToolTip}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- 列 11: 最近运行结果 -->
                            <GridViewColumn Header="{loc:Loc Tasks.MgrLastResult, Default='最近结果'}" Width="125">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OutcomeDisplayText}" Foreground="#FF64748B" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutcomeDisplayText}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 空状态提示 -->
                <StackPanel x:Name="EmptyHintPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{loc:Loc Tasks.MgrNoTasksYet, Default='📋 暂无任务'}" FontSize="16" FontWeight="Bold" Foreground="#FF94A3B8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:Loc Tasks.MgrClickNewTaskAbove, Default='点击上方【＋ 新建任务】创建您的第一个自动化计划任务'}" FontSize="12" Foreground="#FFCBD5E1" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部状态栏卡片 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <!-- 左侧总开关与统计 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <CheckBox x:Name="GlobalEnabledBox" Content="{loc:Loc Tasks.MgrEnableAutomatedTaskScheduling, Default='启用自动化任务调度总开关'}" VerticalAlignment="Center" FontWeight="SemiBold" Click="OnGlobalEnabledClick" ToolTip="{loc:Loc Tasks.MgrDisablingThisPausesAll, Default='关闭后所有自动化任务将暂停触发'}"/>
                    <Separator Width="1" Height="16" Margin="14,0,14,0" Background="#FFE2E8F0"/>
                    <TextBlock x:Name="StatsSummaryText" Text="{loc:Loc Tasks.Mgr0Tasks0Running, Default='共 0 个任务 · 0 个运行中 · 0 个已禁用'}" Foreground="#FF64748B" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧关闭按钮 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{loc:Loc Tasks.MgrClose, Default='关闭'}" Height="30" Padding="16,0" IsCancel="True" Click="OnCloseClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

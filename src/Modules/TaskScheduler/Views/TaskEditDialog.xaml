<Window x:Class="CarroDesk.Modules.TaskScheduler.Views.TaskEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        Title="编辑任务 - CarroDesk" Height="620" Width="820" MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FFF8FAFC">
    <Window.Resources>
        <!-- 现代极简窄滚动条 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border Background="#FF94A3B8" CornerRadius="3" Opacity="0.4"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 通用按钮样式 -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1E293B"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作强调按钮 -->
        <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题横条 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock x:Name="HeaderTitleText" Text="编辑自动化任务" FontSize="15" FontWeight="Bold" Foreground="#FF0F172A" VerticalAlignment="Center"/>
                    <Border x:Name="DirtyIndicator" Background="#FEF3C7" CornerRadius="3" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="未保存更改" FontSize="11" Foreground="#B45309" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TaskSubtitleText" Text="显式点击【确定保存】才会生效" FontSize="12" Foreground="#FF64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 中部表单主体 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,16">

                <!-- 1. 基本信息卡片 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="基础属性" FontWeight="Bold" FontSize="13" Foreground="#FF1E293B" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" MinWidth="100"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="任务名称 *" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="NameBox" Grid.Column="1" Height="28" Margin="0,3" Padding="6,4" TextChanged="OnFormFieldChanged"/>
                            <CheckBox x:Name="EnabledBox" Grid.Column="2" Content="启用此任务" VerticalAlignment="Center" Margin="14,0,0,0" IsChecked="True" Click="OnFormFieldChanged"/>

                            <TextBlock Text="说明提示" Grid.Row="1" VerticalAlignment="Center" Foreground="#FF64748B" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="唯一标识，日志将自动写入 logs/task-{name}.log" Foreground="#FF94A3B8" FontSize="11" Margin="0,3,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. 触发方式卡片 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="触发方式 (Trigger)" FontWeight="Bold" FontSize="13" Foreground="#FF1E293B" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="触发类型 *" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <ComboBox x:Name="TriggerTypeBox" Grid.Column="1" Height="28" SelectionChanged="TriggerTypeBox_SelectionChanged">
                                <ComboBoxItem Content="startup - 系统启动/程序运行后延迟触发" Tag="startup"/>
                                <ComboBoxItem Content="interval - 循环间隔调度（如每隔 30 分钟）" Tag="interval"/>
                                <ComboBoxItem Content="daily - 每天固定时间点执行" Tag="daily"/>
                                <ComboBoxItem Content="cron - 标准 Cron 表达式调度" Tag="cron"/>
                                <ComboBoxItem Content="watch - 文件夹文件变动实时监听" Tag="watch"/>
                                <ComboBoxItem Content="sessionLock - 屏幕锁定时触发" Tag="sessionLock"/>
                                <ComboBoxItem Content="sessionUnlock - 屏幕解锁时触发" Tag="sessionUnlock"/>
                                <ComboBoxItem Content="idle - 用户系统空闲后触发" Tag="idle"/>
                                <ComboBoxItem Content="manual - 手动任务（仅通过托盘/大盘点击触发）" Tag="manual"/>
                                <ComboBoxItem Content="hotkey - 全局自定义快捷键触发" Tag="hotkey"/>
                            </ComboBox>
                        </Grid>

                        <!-- 动态触发参数区 -->
                        <!-- Startup -->
                        <Grid x:Name="PanelStartup" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="延迟秒数" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="DelaySecBox" Grid.Column="1" Height="26" Margin="0,2" Padding="5,2" Text="5" TextChanged="OnFormFieldChanged"/>
                            <TextBlock Grid.Column="2" Text="程序启动后等待 N 秒再执行" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF94A3B8" FontSize="11"/>
                        </Grid>

                        <!-- Interval -->
                        <Grid x:Name="PanelInterval" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="执行间隔" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="IntervalBox" Grid.Column="1" Height="26" Margin="0,2" Padding="5,2" Text="60s" TextChanged="OnFormFieldChanged"/>
                            <TextBlock Grid.Column="2" Text="支持如 30s、5m、1h30m 或秒数" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF94A3B8" FontSize="11"/>
                        </Grid>

                        <!-- Daily -->
                        <Grid x:Name="PanelDaily" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="每天时间" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="DailyTimeBox" Grid.Column="1" Height="26" Margin="0,2" Padding="5,2" Text="02:00" TextChanged="OnFormFieldChanged"/>
                            <TextBlock Grid.Column="2" Text="格式如 09:30 或 22:00:00" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF94A3B8" FontSize="11"/>
                        </Grid>

                        <!-- Cron -->
                        <StackPanel x:Name="PanelCron" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Cron 表达式" VerticalAlignment="Center" Foreground="#FF334155"/>
                                <TextBox x:Name="CronBox" Grid.Column="1" Height="26" Margin="0,2" Padding="5,2" Text="0 9 * * 1" TextChanged="CronBox_TextChanged"/>
                            </Grid>
                            <TextBlock x:Name="CronNextTimeText" Text="下次: --" FontSize="11" Foreground="#FF047857" Margin="90,4,0,0"/>
                        </StackPanel>

                        <!-- Watch -->
                        <StackPanel x:Name="PanelWatch" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="监听目录 *" VerticalAlignment="Center" Foreground="#FF334155"/>
                                <TextBox x:Name="WatchPathBox" Grid.Column="1" Height="26" Margin="0,2" Padding="5,2" TextChanged="OnFormFieldChanged"/>
                                <Button Grid.Column="2" Content="浏览..." Height="26" Margin="6,0,0,0" Padding="10,2" Click="OnBrowseWatchDirClick"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="过滤通配符" VerticalAlignment="Center" Foreground="#FF334155"/>
                                <TextBox x:Name="WatchFilterBox" Grid.Column="1" Height="26" Margin="0,2" Padding="5,2" Text="*.*" TextChanged="OnFormFieldChanged"/>
                                <TextBlock Grid.Column="2" Text="事件类型" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF334155"/>
                                <ComboBox x:Name="WatchEventBox" Grid.Column="3" Height="26" SelectionChanged="OnFormFieldChanged">
                                    <ComboBoxItem Content="created (新建)" Tag="created" IsSelected="True"/>
                                    <ComboBoxItem Content="changed (修改)" Tag="changed"/>
                                    <ComboBoxItem Content="deleted (删除)" Tag="deleted"/>
                                    <ComboBoxItem Content="renamed (重命名)" Tag="renamed"/>
                                    <ComboBoxItem Content="all (所有变动)" Tag="all"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="可在动作参数中使用 {{file}} 接收变动文件全路径，{{fileName}} 接收文件名" Foreground="#FF64748B" FontSize="11" Margin="90,3,0,0"/>
                        </StackPanel>

                        <!-- Hotkey -->
                        <Grid x:Name="PanelHotkey" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="全局热键" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="HotkeyBox" Grid.Column="1" Height="26" Margin="0,2" Padding="5,2" Text="Ctrl+Alt+Q" TextChanged="OnFormFieldChanged"/>
                            <TextBlock Grid.Column="2" Text="如 Ctrl+Alt+Shift+F12" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF94A3B8" FontSize="11"/>
                        </Grid>

                        <!-- Idle -->
                        <Grid x:Name="PanelIdle" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="空闲分钟数" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="IdleMinutesBox" Grid.Column="1" Height="26" Margin="0,2" Padding="5,2" Text="5" TextChanged="OnFormFieldChanged"/>
                            <TextBlock Grid.Column="2" Text="无键盘鼠标动作达此分钟后触发" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF94A3B8" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. 执行动作卡片 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="执行动作 (Action)" FontWeight="Bold" FontSize="13" Foreground="#FF1E293B" Margin="0,0,0,10"/>
                        
                        <!-- 文件/脚本 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="目标文件 *" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="FileBox" Grid.Column="1" Height="28" Margin="0,2" Padding="6,3" TextChanged="OnFormFieldChanged"/>
                            <Button Grid.Column="2" Content="浏览..." Height="28" Margin="6,0,0,0" Padding="10,2" Click="OnBrowseFileClick"/>
                            <ComboBox x:Name="ScriptQuickBox" Grid.Column="3" Width="140" Height="28" Margin="6,0,0,0" SelectionChanged="ScriptQuickBox_SelectionChanged" ToolTip="快速从 scripts/ 目录选择脚本"/>
                        </Grid>

                        <!-- 启动参数 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="命令行参数" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="ArgsBox" Grid.Column="1" Height="28" Margin="0,2" Padding="6,3" TextChanged="OnFormFieldChanged"/>
                            <Button x:Name="InsertTemplateBtn" Grid.Column="2" Content="插入变量 ▾" Height="28" Margin="6,0,0,0" Padding="10,2" Click="OnInsertTemplateClick"/>
                        </Grid>

                        <!-- 工作目录 -->
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="工作目录" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="WorkDirBox" Grid.Column="1" Height="28" Margin="0,2" Padding="6,3" TextChanged="OnFormFieldChanged"/>
                            <Button Grid.Column="2" Content="选择..." Height="28" Margin="6,0,0,0" Padding="10,2" Click="OnBrowseWorkDirClick"/>
                        </Grid>
                        <TextBlock Text="留空时自动以目标文件所在目录或 scripts/ 目录为工作目录" Foreground="#FF94A3B8" FontSize="11" Margin="90,2,0,6"/>

                        <!-- 环境变量 -->
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="环境变量" VerticalAlignment="Top" Margin="0,5,0,0" Foreground="#FF334155"/>
                            <TextBox x:Name="EnvBox" Grid.Column="1" Height="48" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,2" Padding="6,4" TextChanged="OnFormFieldChanged" ToolTip="每行一个 KEY=VALUE"/>
                        </Grid>
                        <TextBlock Text="格式：每行一个 KEY=VALUE，可在值中使用 {{date}} 等变量" Foreground="#FF94A3B8" FontSize="11" Margin="90,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4. 高级选项卡片 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE2E8F0" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="高级选项 (Options &amp; Conditions)" FontWeight="Bold" FontSize="13" Foreground="#FF1E293B" Margin="0,0,0,10"/>
                        
                        <WrapPanel Margin="0,0,0,10">
                            <CheckBox x:Name="HiddenBox" Content="后台静默（隐藏黑窗口）" Margin="0,4,20,4" IsChecked="True" Click="OnFormFieldChanged"/>
                            <CheckBox x:Name="RunAtStartupBox" Content="启动即跑（无需等首个间隔）" Margin="0,4,20,4" Click="OnFormFieldChanged"/>
                            <CheckBox x:Name="CatchUpMissedBox" Content="错过补跑（关机漏跑补偿）" Margin="0,4,20,4" Click="OnFormFieldChanged"/>
                            <CheckBox x:Name="NotifyOnFailureBox" Content="失败时弹窗通知" Margin="0,4,20,4" IsChecked="True" Click="OnFormFieldChanged"/>
                        </WrapPanel>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="运行模式" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <ComboBox x:Name="ModeBox" Grid.Column="1" Height="26" SelectionChanged="OnModeSelectionChanged">
                                <ComboBoxItem Content="wait (单次运行)" Tag="wait" IsSelected="True"/>
                                <ComboBoxItem Content="detach (后台常驻)" Tag="detach"/>
                            </ComboBox>

                            <TextBlock Text="控制台编码" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF334155"/>
                            <ComboBox x:Name="EncodingBox" Grid.Column="3" Height="26" SelectionChanged="OnFormFieldChanged">
                                <ComboBoxItem Content="自动 (ANSI/OEM/UTF-8)" Tag="" IsSelected="True"/>
                                <ComboBoxItem Content="GBK (CP936)" Tag="gbk"/>
                                <ComboBoxItem Content="UTF-8" Tag="utf-8"/>
                            </ComboBox>
                        </Grid>

                        <!-- wait 专有 -->
                        <Grid x:Name="PanelWaitOptions" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="超时秒数" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="TimeoutBox" Grid.Column="1" Height="26" Padding="5,2" Text="0" TextChanged="OnFormFieldChanged"/>
                            <TextBlock Text="失败重试" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF334155"/>
                            <TextBox x:Name="RetryBox" Grid.Column="3" Height="26" Padding="5,2" Text="0" TextChanged="OnFormFieldChanged"/>
                            <CheckBox x:Name="AllowConcurrentBox" Grid.Column="4" Content="允许并发多实例" VerticalAlignment="Center" Margin="16,0,0,0" Click="OnFormFieldChanged"/>
                        </Grid>

                        <!-- detach 专有 -->
                        <StackPanel x:Name="PanelDetachOptions" Visibility="Collapsed" Margin="0,6,0,0">
                            <WrapPanel Margin="0,0,0,6">
                                <CheckBox x:Name="KillWithHostBox" Content="随宿主退出终止进程树" Margin="0,4,20,4" IsChecked="True" Click="OnFormFieldChanged"/>
                                <CheckBox x:Name="SingleInstanceBox" Content="跨宿主单实例互斥" Margin="0,4,20,4" Click="OnFormFieldChanged"/>
                                <CheckBox x:Name="RestartOnFailureBox" Content="意外退出守护重启" Margin="0,4,20,4" Click="OnFormFieldChanged"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="90"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="重启延迟" VerticalAlignment="Center" Foreground="#FF334155"/>
                                <TextBox x:Name="RestartDelayBox" Grid.Column="1" Height="26" Padding="5,2" Text="5" TextChanged="OnFormFieldChanged"/>
                                <TextBlock Text="最大失败预算" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF334155"/>
                                <TextBox x:Name="RestartLimitBox" Grid.Column="3" Height="26" Padding="5,2" Text="3" TextChanged="OnFormFieldChanged"/>
                            </Grid>
                        </StackPanel>

                        <!-- 前置条件 When -->
                        <Separator Margin="0,12,0,10"/>
                        <TextBlock Text="前置约束条件 (可选)" FontWeight="SemiBold" FontSize="12" Foreground="#FF475569" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,6">
                            <CheckBox x:Name="OnlyIdleBox" Content="仅空闲时运行" Margin="0,4,20,4" Click="OnFormFieldChanged"/>
                            <CheckBox x:Name="AcPowerBox" Content="仅交流供电运行" Margin="0,4,20,4" Click="OnFormFieldChanged"/>
                            <CheckBox x:Name="NetworkBox" Content="仅有网络时运行" Margin="0,4,20,4" Click="OnFormFieldChanged"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="需存在文件" VerticalAlignment="Center" Foreground="#FF334155"/>
                            <TextBox x:Name="FileExistsBox" Grid.Column="1" Height="24" Margin="0,2" Padding="4,2" TextChanged="OnFormFieldChanged"/>
                            <TextBlock Text="需不存在文件" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF334155"/>
                            <TextBox x:Name="FileNotExistsBox" Grid.Column="3" Height="24" Margin="0,2" Padding="4,2" TextChanged="OnFormFieldChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定动作栏 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <!-- 左侧测试运行 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="TestRunButton" Content="▶ 测试运行" Height="32" Padding="14,0" Click="OnTestRunClick"/>
                    <Button x:Name="TestStopButton" Content="⏹ 停止测试" Height="32" Padding="14,0" Click="OnTestStopClick" Visibility="Collapsed"/>
                    <TextBlock x:Name="TestStatusText" Text="" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF64748B" FontSize="12"/>
                </StackPanel>

                <!-- 右侧保存/取消 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="确定保存" Style="{StaticResource PrimaryBtn}" Height="32" Margin="0,0,10,0" Click="OnSaveClick"/>
                    <Button Content="取消" Height="32" Padding="16,0" IsCancel="True" Click="OnCancelClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="CarroDesk.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        Title="{loc:Loc About.Title, Default='关于 CarroDesk'}"
        Height="580" Width="520" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#FFF8FAFC"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12" Foreground="#FF1E293B"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <!-- 现代窄滚动条 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MaxWidth" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="ThumbBorder" Background="#FF999999" CornerRadius="3" Opacity="0.35"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF555555"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF222222"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 扁平现代按钮 -->
        <Style x:Key="ModernButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FF334155"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#FF2563EB"/>
            <Setter Property="BorderBrush" Value="#FF1D4ED8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: 顶部头部卡片 -->
            <RowDefinition Height="Auto"/>
            <!-- 1: 系统环境概览 -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 模块列表区域 -->
            <RowDefinition Height="*"/>
            <!-- 3: 底部按钮栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: 顶部应用信息卡片 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.04" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 应用图标 -->
                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" VerticalAlignment="Top" Margin="0,0,14,0">
                    <Image x:Name="AppLogoImage" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- 标题与版本 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CarroDesk" FontSize="18" FontWeight="Bold" Foreground="#FF0F172A" VerticalAlignment="Center"/>
                        <Border Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadgeText" Text="v1.3.1" FontSize="11" FontWeight="SemiBold" Foreground="#FF1D4ED8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{loc:Loc About.Tagline, Default='模块化 Windows 效率与自动化工具箱'}" FontSize="12" Foreground="#FF64748B" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{loc:Loc About.Commit, Default='提交'}" FontSize="11" Foreground="#FF94A3B8"/>
                        <TextBlock Text=": " FontSize="11" Foreground="#FF94A3B8"/>
                        <TextBlock x:Name="CommitText" Text="unknown" FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="#FF64748B" Margin="0,0,12,0"/>

                        <TextBlock Text="{loc:Loc About.BuildTime, Default='构建时间'}" FontSize="11" Foreground="#FF94A3B8"/>
                        <TextBlock Text=": " FontSize="11" Foreground="#FF94A3B8"/>
                        <TextBlock x:Name="BuildTimeText" Text="unknown" FontSize="11" Foreground="#FF64748B"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1: 运行环境卡片 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 运行时 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                    <TextBlock Text="{loc:Loc About.Runtime, Default='运行环境'}" FontSize="11" Foreground="#FF94A3B8"/>
                    <TextBlock x:Name="RuntimeText" Text=".NET 10" FontSize="11" FontWeight="SemiBold" Foreground="#FF334155" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 部署模式 -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,6">
                    <TextBlock Text="部署模式" FontSize="11" Foreground="#FF94A3B8"/>
                    <TextBlock x:Name="ModeText" Text="便携模式" FontSize="11" FontWeight="SemiBold" Foreground="#FF334155" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 数据目录 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                    <TextBlock Text="{loc:Loc About.DataPath, Default='数据目录'}" FontSize="11" Foreground="#FF94A3B8"/>
                    <TextBlock x:Name="DataPathText" Text="C:\..." FontSize="11" FontFamily="Consolas, Cascadia Code" Foreground="#FF475569" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2: 模块清单区域 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 模块区标题栏 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock Text="{loc:Loc About.ModulesTitle, Default='已加载业务模块'}" FontWeight="Bold" FontSize="13" Foreground="#FF0F172A" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModulesCountText" DockPanel.Dock="Right" Text="共 8 个模块" FontSize="11" Foreground="#FF64748B" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- 模块滚动列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ModulesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 第一行：状态灯 + 模块名 + 版本 + ID + 状态文字 -->
                                        <DockPanel Grid.Row="0" LastChildFill="False">
                                            <!-- 状态指示灯圆点 -->
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <!-- 模块名称 -->
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#FF1E293B" VerticalAlignment="Center"/>

                                            <!-- 版本号徽章 -->
                                            <Border Background="#FFE2E8F0" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="10" Foreground="#FF475569"/>
                                            </Border>

                                            <!-- 模块 Id 标签 -->
                                            <TextBlock Text="{Binding Id, StringFormat='[{0}]'}" FontFamily="Consolas, Cascadia Code" FontSize="10" Foreground="#FF94A3B8" Margin="6,0,0,0" VerticalAlignment="Center"/>

                                            <!-- 状态文本（靠右） -->
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <!-- 第二行：模块描述（若有） -->
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="#FF64748B" TextWrapping="Wrap" Margin="16,4,0,0"
                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3: 底部操作栏 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 复制诊断信息 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ModernButtonStyle}" Content="{loc:Loc About.CopyInfo, Default='复制诊断信息'}" Click="OnCopyInfoClick"/>
                <TextBlock x:Name="CopiedToastText" Text="{loc:Loc About.Copied, Default='已复制到剪贴板！'}" Foreground="#FF16A34A" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 关闭/确定按钮 -->
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="{loc:Loc About.Close, Default='确定'}" MinWidth="75" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</Window>

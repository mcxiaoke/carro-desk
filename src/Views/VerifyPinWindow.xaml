<Window x:Class="ScreenLock.Views.VerifyPinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenLock - 安全验证" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF6F7F9" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 通用现代按钮样式 -->
        <Style x:Key="ModernBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF2A2A2A"/>
            <Setter Property="BorderBrush" Value="#FFCECECE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF2F4F7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFB0B8C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE2E6EC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作蓝色按钮 -->
        <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF1F6FEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF388BFD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1158C7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border x:Name="MainCard" Background="White" CornerRadius="8" BorderBrush="#FFE2E5E8" BorderThickness="1" Padding="22,20">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardTransform" X="0" Y="0"/>
            </Border.RenderTransform>
            <StackPanel>
                <!-- 头部：安全盾牌图标 + 标题与说明 -->
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="#EEF4FF" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1 6h2v2h-2V7zm0 4h2v6h-2v-6z"
                              Fill="#1F6FEB" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="验证身份" FontSize="15" FontWeight="Bold" Foreground="#FF1F2328"/>
                        <TextBlock Text="请输入安全 PIN 码继续操作" FontSize="12" Foreground="#FF656D76" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- 密码输入框 -->
                <PasswordBox x:Name="PinBox" Height="36" FontSize="18" MaxLength="16" Padding="8,4"
                             HorizontalContentAlignment="Center" Margin="0,18,0,0" BorderBrush="#FFD0D7DE"/>

                <!-- 键盘状态提示 (CapsLock) -->
                <TextBlock x:Name="KeyHintText" FontSize="11" Foreground="#FFD97706" Margin="0,6,0,0"
                           Visibility="Collapsed" Text="⚠️ 大写锁定 (Caps Lock) 已开启"/>

                <!-- 错误提示 -->
                <TextBlock x:Name="MessageText" FontSize="12" Foreground="#FFD93025" Margin="0,6,0,0"
                           TextWrapping="Wrap" MinHeight="16"/>

                <!-- 底部按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="取消" Width="80" Height="30" Margin="0,0,10,0" Style="{StaticResource ModernBtn}" IsCancel="True" Click="OnCancelClick"/>
                    <Button Content="确定" Width="88" Height="30" Style="{StaticResource PrimaryBtn}" IsDefault="True" Click="OnOkClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

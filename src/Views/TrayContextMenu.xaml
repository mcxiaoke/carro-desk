<ContextMenu x:Class="ScreenLock.Views.TrayContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             FontSize="12" Foreground="#FF24292F"
             OverridesDefaultStyle="True"
             Grid.IsSharedSizeScope="True">
    <ContextMenu.Template>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Background="White" BorderBrush="#FFE2E5E8" BorderThickness="1" CornerRadius="8" Padding="4" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#000000"/>
                </Border.Effect>
                <StackPanel IsItemsHost="True"/>
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>
    <ContextMenu.Resources>
        <!-- 分隔线样式 -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#FFE9ECEF" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通叶子菜单项模板 -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="8,6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" SharedSizeGroup="CheckGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ArrowGroup"/>
                    </Grid.ColumnDefinitions>

                    <!-- 勾选状态标记 -->
                    <Path x:Name="CheckMark" Data="M 0 4 L 3 7 L 8 1" Stroke="#FF1A73E8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>

                    <!-- 标题文本 -->
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="2,0,14,0"/>

                    <!-- 快捷手势文本 -->
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#FF888888" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FFF0F3F6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 带有子菜单的菜单头项模板 -->
        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="8,6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" SharedSizeGroup="CheckGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ArrowGroup"/>
                    </Grid.ColumnDefinitions>

                    <!-- 勾选状态标记 -->
                    <Path x:Name="CheckMark" Data="M 0 4 L 3 7 L 8 1" Stroke="#FF1A73E8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>

                    <!-- 标题文本 -->
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="2,0,14,0"/>

                    <!-- 右侧展开小箭头 -->
                    <Path Grid.Column="2" Data="M 0 0 L 4 4 L 0 8" Stroke="#FF666666" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="8,0,2,0"/>

                    <!-- 子菜单弹出层：自适应现代阴影微卡片 -->
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" VerticalOffset="-4" HorizontalOffset="2">
                        <Border Background="White" BorderBrush="#FFE2E5E8" BorderThickness="1" CornerRadius="8" Padding="4" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.14" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FFF0F3F6"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FFE8ECEF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 菜单项默认样式 -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="True">
                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>


    </ContextMenu.Resources>

    <!-- 顶部实时状态指示卡片 -->
    <MenuItem Focusable="False" StaysOpenOnClick="True" Cursor="Arrow">
        <MenuItem.Template>
            <ControlTemplate TargetType="{x:Type MenuItem}">
                <ContentPresenter ContentSource="Header"/>
            </ControlTemplate>
        </MenuItem.Template>
        <MenuItem.Header>
            <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="2,2,2,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ScreenLock" FontWeight="Bold" FontSize="12" Foreground="#FF1E293B"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusDetailText" Text="空闲 5 分钟后锁定" FontSize="11" Foreground="#FF64748B" Margin="13,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="StatusBadgeBorder" Grid.Column="1" Background="#FFECFDF5" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadge" Text="运行中" FontSize="10" FontWeight="SemiBold" Foreground="#FF059669"/>
                    </Border>
                </Grid>
            </Border>
        </MenuItem.Header>
    </MenuItem>

    <Separator/>

    <!-- 核心操作 -->
    <MenuItem x:Name="LockNowItem" Header="立即锁定" FontWeight="SemiBold" Click="OnLockNowClick"/>

    <Separator/>

    <!-- 空闲锁定预设档位 -->
    <MenuItem x:Name="IdleMenu" Header="空闲锁定">
        <MenuItem Header="0 - 禁用" Tag="0" Click="OnIdlePresetClick"/>
        <MenuItem Header="1 分钟" Tag="1" Click="OnIdlePresetClick"/>
        <MenuItem Header="3 分钟" Tag="3" Click="OnIdlePresetClick"/>
        <MenuItem Header="5 分钟" Tag="5" Click="OnIdlePresetClick"/>
        <MenuItem Header="10 分钟" Tag="10" Click="OnIdlePresetClick"/>
        <MenuItem Header="15 分钟" Tag="15" Click="OnIdlePresetClick"/>
        <MenuItem Header="30 分钟" Tag="30" Click="OnIdlePresetClick"/>
    </MenuItem>

    <!-- 暂停计时 -->
    <MenuItem x:Name="PauseMenu" Header="暂停计时">
        <MenuItem Header="暂停 30 分钟" Click="OnPause30Click"/>
        <MenuItem Header="暂停 1 小时" Click="OnPause60Click"/>
        <MenuItem Header="恢复计时" Click="OnResumeIdleClick"/>
    </MenuItem>

    <!-- 开机自启 -->
    <MenuItem x:Name="AutoStartItem" Header="开机自启" Click="OnAutoStartClick"/>

    <Separator/>

    <!-- 配置与任务编辑器 -->
    <MenuItem Header="配置编辑器..." Click="OnConfigEditorClick"/>
    <MenuItem x:Name="TaskMenu" Header="任务">
        <MenuItem x:Name="TasksEnabledItem" Header="启用任务调度" Click="OnTasksEnabledToggleClick"/>
        <Separator/>
        <MenuItem x:Name="ManualMenu" Header="手动运行"/>
        <MenuItem x:Name="RecentMenu" Header="最近运行"/>
        <Separator/>
        <MenuItem Header="任务编辑器..." Click="OnTaskEditorClick"/>
        <MenuItem Header="重载任务 (tasks.json)" Click="OnReloadTasksClick"/>
    </MenuItem>
    <MenuItem Header="打开配置目录" Click="OnOpenConfigDirClick"/>
    <MenuItem Header="重载配置 (settings.json)" Click="OnReloadConfigClick"/>

    <Separator/>

    <!-- 退出 -->
    <MenuItem Header="退出..." Click="OnExitClick"/>
</ContextMenu>

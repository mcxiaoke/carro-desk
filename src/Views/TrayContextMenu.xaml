<ContextMenu x:Class="CarroDesk.Views.TrayContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
             FontFamily="Segoe UI, Microsoft YaHei UI"
             FontSize="12" Foreground="#FF24292F"
             OverridesDefaultStyle="True"
             Grid.IsSharedSizeScope="True">
    <ContextMenu.Template>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Background="White" BorderBrush="#FFE2E5E8" BorderThickness="1" CornerRadius="8" Padding="4" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#000000"/>
                </Border.Effect>
                <StackPanel IsItemsHost="True"/>
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>
    <ContextMenu.Resources>
        <!-- 分隔线样式 -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#FFE9ECEF" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通叶子菜单项模板 -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="8,6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" SharedSizeGroup="CheckGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ArrowGroup"/>
                    </Grid.ColumnDefinitions>

                    <!-- 勾选状态标记 -->
                    <Path x:Name="CheckMark" Data="M 0 4 L 3 7 L 8 1" Stroke="#FF1A73E8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>

                    <!-- 标题文本 -->
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="2,0,14,0"/>

                    <!-- 快捷手势文本 -->
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#FF888888" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FFF0F3F6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 带有子菜单的菜单头项模板 -->
        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="8,6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" SharedSizeGroup="CheckGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ArrowGroup"/>
                    </Grid.ColumnDefinitions>

                    <!-- 勾选状态标记 -->
                    <Path x:Name="CheckMark" Data="M 0 4 L 3 7 L 8 1" Stroke="#FF1A73E8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>

                    <!-- 标题文本 -->
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="2,0,14,0"/>

                    <!-- 右侧展开小箭头 -->
                    <Path Grid.Column="2" Data="M 0 0 L 4 4 L 0 8" Stroke="#FF666666" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="8,0,2,0"/>

                    <!-- 子菜单弹出层：自适应现代阴影微卡片 -->
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" VerticalOffset="-4" HorizontalOffset="2">
                        <Border Background="White" BorderBrush="#FFE2E5E8" BorderThickness="1" CornerRadius="8" Padding="4" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.14" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FFF0F3F6"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FFE8ECEF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 菜单项默认样式 -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="True">
                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>


    </ContextMenu.Resources>

    <!-- 顶部实时状态指示卡片 -->
    <MenuItem Focusable="False" StaysOpenOnClick="True" Cursor="Arrow">
        <MenuItem.Template>
            <ControlTemplate TargetType="{x:Type MenuItem}">
                <ContentPresenter ContentSource="Header"/>
            </ControlTemplate>
        </MenuItem.Template>
        <MenuItem.Header>
            <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="2,2,2,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc Tray.Title, Default='CarroDesk'}" FontWeight="Bold" FontSize="12" Foreground="#FF1E293B"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusDetailText" Text="--" FontSize="11" Foreground="#FF64748B" Margin="13,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="StatusBadgeBorder" Grid.Column="1" Background="#FFECFDF5" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadge" Text="--" FontSize="10" FontWeight="SemiBold" Foreground="#FF059669"/>
                    </Border>
                </Grid>
            </Border>
        </MenuItem.Header>
    </MenuItem>

    <Separator/>

    <!-- 核心操作 -->
    <MenuItem x:Name="LockNowItem" Header="{loc:Loc Tray.LockNow}" FontWeight="SemiBold" Click="OnLockNowClick"/>

    <Separator/>

    <!-- 空闲锁定预设档位 -->
    <MenuItem x:Name="IdleMenu" Header="{loc:Loc Tray.IdleLock}">
        <MenuItem x:Name="Idle0Item" Header="{loc:Loc Tray.IdleDisabled}" Tag="0" Click="OnIdlePresetClick"/>
        <MenuItem Tag="1" Click="OnIdlePresetClick"/>
        <MenuItem Tag="3" Click="OnIdlePresetClick"/>
        <MenuItem Tag="5" Click="OnIdlePresetClick"/>
        <MenuItem Tag="10" Click="OnIdlePresetClick"/>
        <MenuItem Tag="15" Click="OnIdlePresetClick"/>
        <MenuItem Tag="30" Click="OnIdlePresetClick"/>
    </MenuItem>

    <!-- 暂停计时 -->
    <MenuItem x:Name="PauseMenu" Header="{loc:Loc Tray.PauseTimer}">
        <MenuItem Header="{loc:Loc Tray.Pause30Min}" Click="OnPause30Click"/>
        <MenuItem Header="{loc:Loc Tray.Pause1Hour}" Click="OnPause60Click"/>
        <MenuItem Header="{loc:Loc Tray.ResumeTimer}" Click="OnResumeIdleClick"/>
    </MenuItem>

    <!-- 开机自启 -->
    <MenuItem x:Name="AutoStartItem" Header="{loc:Loc Tray.AutoStart}" Click="OnAutoStartClick"/>

    <Separator/>

    <!-- 配置与任务编辑器 -->
    <MenuItem Header="{loc:Loc Tray.ConfigEditor}" Click="OnConfigEditorClick"/>
    <MenuItem x:Name="TaskMenu" Header="{loc:Loc Tray.Tasks}">
        <MenuItem x:Name="TasksEnabledItem" Header="{loc:Loc Tray.TasksEnabled}" Click="OnTasksEnabledToggleClick"/>
        <Separator/>
        <MenuItem x:Name="ManualMenu" Header="{loc:Loc Tray.ManualRun}"/>
        <MenuItem x:Name="RecentMenu" Header="{loc:Loc Tray.RecentRun}"/>
        <Separator/>
        <MenuItem Header="{loc:Loc Tray.TaskEditor}" Click="OnTaskEditorClick"/>
        <MenuItem Header="{loc:Loc Tray.ReloadTasks}" Click="OnReloadTasksClick"/>
    </MenuItem>

    <!-- 音频工具 (Audio Tools) -->
    <MenuItem x:Name="AudioMenu" Header="{loc:Loc Tray.AudioTools, Default='音频工具'}">
        <MenuItem x:Name="AudioSwitchMenu" Header="{loc:Loc Tray.AudioSwitch, Default='音频输出设备'}">
            <MenuItem x:Name="AudioSwitchFastToggleItem" Header="快捷切换 (耳机 ⇄ 扬声器)" InputGestureText="Ctrl+`" Click="OnAudioSwitchClick"/>
            <Separator x:Name="AudioDeviceSeparator"/>
        </MenuItem>
        <Separator/>
        <MenuItem x:Name="AppAutoMuteItem" Header="{loc:Loc Tray.AppAutoMute, Default='应用后台自动静音'}" InputGestureText="Ctrl+Win+S" Click="OnAppAutoMuteClick"/>
        <MenuItem x:Name="AppAutoMuteSettingsItem" Header="{loc:Loc Tray.AppAutoMuteSettings, Default='后台静音设置...'}" Click="OnAppAutoMuteSettingsClick"/>
    </MenuItem>

    <MenuItem Header="{loc:Loc Tray.OpenConfigDir}" Click="OnOpenConfigDirClick"/>
    <MenuItem Header="{loc:Loc Tray.ReloadConfig}" Click="OnReloadConfigClick"/>

    <!-- 语言切换 -->
    <MenuItem x:Name="LanguageMenu" Header="{loc:Loc Tray.Language}">
        <MenuItem x:Name="LangAutoItem" Header="{loc:Loc Tray.LangAuto}" Tag="auto" Click="OnLanguageSelectClick"/>
        <Separator/>
        <MenuItem x:Name="LangZhItem" Header="{loc:Loc Tray.LangZh}" Tag="zh-CN" Click="OnLanguageSelectClick"/>
        <MenuItem x:Name="LangEnItem" Header="{loc:Loc Tray.LangEn}" Tag="en-US" Click="OnLanguageSelectClick"/>
    </MenuItem>

    <Separator/>

    <!-- 退出 -->
    <MenuItem Header="{loc:Loc Tray.Exit}" Click="OnExitClick"/>
</ContextMenu>

<Window x:Class="CarroDesk.Views.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        Title="{loc:Loc Config.Title}" Height="720" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF6F7F9">
    <Window.Resources>
        <!-- 现代极简窄滚动条：6px 动态悬浮 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MaxWidth" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="ThumbBorder" Background="#FF999999" CornerRadius="3" Opacity="0.35"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF555555"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF222222"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 现代通用按钮样式 -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF2A2A2A"/>
            <Setter Property="BorderBrush" Value="#FFCECECE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF2F4F7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFB0B8C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE2E6EC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主操作强调按钮样式（修复悬停白底白字缺陷） -->
        <Style x:Key="PrimaryBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF1558B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0D3C7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容滚动区：外层铺满贴边，内层留白 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,12,12,12">
                <!-- 路径提示微卡片 -->
                <Border Background="#FFEBF2FB" CornerRadius="6" BorderBrush="#FFD3E3F8" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc Config.ConfigLocation}" FontWeight="Bold" FontSize="11" Foreground="#FF1A73E8"/>
                            <TextBlock x:Name="PathText" Text="--" FontSize="11" Foreground="#FF333333" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock x:Name="ModeText" Text="--" FontSize="10" Foreground="#FF777777" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:Loc Common.OpenDir}" Height="26" Margin="8,0,0,0" Padding="10,2" VerticalAlignment="Center" Click="OnOpenConfigDirClick"/>
                    </Grid>
                </Border>

                <!-- 基础设置 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE4E7EB" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Config.BasicSettings}" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="110"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <TextBlock Text="{loc:Loc Config.LanguageLabel}" VerticalAlignment="Center" Foreground="#FF444444" Margin="0,0,10,0"/>
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" Height="26" Margin="0,3" SelectionChanged="LanguageBox_SelectionChanged">
                                <ComboBoxItem Content="{loc:Loc Tray.LangAuto}" Tag="auto"/>
                                <ComboBoxItem Content="{loc:Loc Tray.LangZh}" Tag="zh-CN"/>
                                <ComboBoxItem Content="{loc:Loc Tray.LangEn}" Tag="en-US"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="" VerticalAlignment="Center" Foreground="#FF888888" FontSize="11" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="1" Text="{loc:Loc Config.IdleLockLabel}" VerticalAlignment="Center" Foreground="#FF444444" Margin="0,0,10,0"/>
                            <ComboBox x:Name="IdleBox" Grid.Row="1" Grid.Column="1" Height="26" Margin="0,3" IsEditable="True" ToolTip="0=禁用，1-1440 分钟">
                                <ComboBoxItem Content="{loc:Loc Config.IdleDisabled}"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="15"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="60"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Loc Config.IdleUnit}" VerticalAlignment="Center" Foreground="#FF888888" FontSize="11" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="2" Text="{loc:Loc Config.ShowClockLabel}" VerticalAlignment="Center" Margin="0,6,10,0" Foreground="#FF444444"/>
                            <CheckBox x:Name="ShowClockBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="{loc:Loc Config.ShowClockDesc}" VerticalAlignment="Center" Margin="0,6,0,0"/>

                            <TextBlock Grid.Row="3" Text="{loc:Loc Config.OpacityLabel}" VerticalAlignment="Center" Margin="0,6,10,0" Foreground="#FF444444"/>
                            <Slider x:Name="OpacitySlider" Grid.Row="3" Grid.Column="1" Minimum="0.3" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="0.88" Margin="0,6,0,0" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityText" Grid.Row="3" Grid.Column="2" Text="88%" VerticalAlignment="Center" Foreground="#FF555555" Margin="8,6,0,0"/>

                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{loc:Loc Config.OpacityHint}" Foreground="#FF888888" FontSize="11" Margin="0,2,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 系统集成 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE4E7EB" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Config.SystemIntegration}" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,6"/>
                        <CheckBox x:Name="AutoStartBox" Content="{loc:Loc Config.AutoStartLabel}" Margin="0,2,0,0"/>
                        <CheckBox x:Name="UnlockOnResumeBox" Content="{loc:Loc Config.UnlockOnResumeLabel}" Margin="0,6,0,0" IsChecked="True"/>
                        <TextBlock Text="{loc:Loc Config.UnlockOnResumeDesc}" Foreground="#FF888888" FontSize="11" Margin="20,2,0,0" TextWrapping="Wrap"/>
                        <CheckBox x:Name="TasksEnabledBox" Content="{loc:Loc Config.TasksEnabledLabel}" Margin="0,6,0,0" IsChecked="True"/>
                        <TextBlock Text="{loc:Loc Config.TasksEnabledDesc}" Foreground="#FF888888" FontSize="11" Margin="20,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 排除进程 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE4E7EB" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Config.ExcludeTitle}" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc Config.ExcludeDesc}" Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExcludeInputBox" Height="26" Padding="5,2" ToolTip="{loc:Loc Config.ExcludeInputPlaceholder}" KeyDown="ExcludeInputBox_KeyDown"/>
                            <Button Content="{loc:Loc Config.PickRunning}" Grid.Column="1" Height="26" Margin="4,0,0,0" Padding="8,0" Click="OnPickRunningProcessClick"/>
                            <Button Content="{loc:Loc Common.Add}" Grid.Column="2" Height="26" Margin="4,0,0,0" Padding="12,0" Click="OnExcludeAddClick"/>
                            <Button Content="{loc:Loc Common.Delete}" Grid.Column="3" Height="26" Margin="4,0,0,0" Padding="12,0" Click="OnExcludeDeleteClick"/>
                        </Grid>
                        <ListBox x:Name="ExcludeList" Height="80" Margin="0,6,0,0" SelectionMode="Single" MouseDoubleClick="ExcludeList_MouseDoubleClick"/>
                        <TextBlock Text="{loc:Loc Config.ExcludeTip}" Foreground="#FF888888" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 安全设置 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE4E7EB" BorderThickness="1" Padding="12,8" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Config.SecurityTitle}" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Config.PinStatusLabel}" VerticalAlignment="Center" Foreground="#FF444444" Margin="0,0,10,0"/>
                            <TextBlock x:Name="PinStatusText" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF333333"/>
                            <Button x:Name="PinButton" Grid.Column="2" Content="{loc:Loc Config.ChangePin}" Height="26" Padding="12,0" Click="OnPinChangeClick"/>
                        </Grid>
                        <TextBlock Text="{loc:Loc Config.PinHint}" Foreground="#FF888888" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidateText" Foreground="#FFD93025" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定底栏：质感微边框，按钮整齐 -->
        <Border Grid.Row="1" Background="#FFF9F9F9" BorderBrush="#FFE2E5E8" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button Content="{loc:Loc Common.ResetDefaults}" DockPanel.Dock="Left" Height="30" Padding="12,0" ToolTip="{loc:Loc Config.ResetDefaultsTooltip}" Click="OnResetDefaultsClick"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{loc:Loc Common.SaveAndApply}" Style="{StaticResource PrimaryBtn}" Height="30" Padding="16,0" Margin="0,0,8,0" Click="OnSaveApplyClick"/>
                    <Button Content="{loc:Loc Common.Close}" Height="30" MinWidth="68" Padding="12,0" Click="OnCloseClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="ScreenLock.Views.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置编辑器 - ScreenLock" Height="700" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#FFF6F7F9">
    <Window.Resources>
        <!-- 现代极简窄滚动条：6px 动态悬浮 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MaxWidth" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="ThumbBorder" Background="#FF999999" CornerRadius="3" Opacity="0.35"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF555555"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="#FF222222"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 现代通用按钮样式 -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF2A2A2A"/>
            <Setter Property="BorderBrush" Value="#FFCECECE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFF2F4F7"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFB0B8C4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE2E6EC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容滚动区：外层铺满贴边，内层留白 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,12,12,12">
                <!-- 路径提示微卡片 -->
                <Border Background="#FFEBF2FB" CornerRadius="6" BorderBrush="#FFD3E3F8" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="配置文件位置" FontWeight="Bold" FontSize="11" Foreground="#FF1A73E8"/>
                            <TextBlock x:Name="PathText" Text="--" FontSize="11" Foreground="#FF333333" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            <TextBlock x:Name="ModeText" Text="--" FontSize="10" Foreground="#FF777777" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开目录" Height="26" Margin="8,0,0,0" Padding="10,2" VerticalAlignment="Center" Click="OnOpenConfigDirClick"/>
                    </Grid>
                </Border>

                <!-- 基础设置 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE4E7EB" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="基础设置" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            
                            <TextBlock Text="空闲锁屏" VerticalAlignment="Center" Foreground="#FF444444"/>
                            <ComboBox x:Name="IdleBox" Grid.Column="1" Height="26" Margin="0,3" IsEditable="True" ToolTip="0=禁用，1-1440 分钟">
                                <ComboBoxItem Content="0 - 禁用"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="15"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="60"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="分钟（输入 0 禁用自动锁定）" VerticalAlignment="Center" Foreground="#FF888888" FontSize="11" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="1" Text="显示时钟" VerticalAlignment="Center" Margin="0,6,0,0" Foreground="#FF444444"/>
                            <CheckBox x:Name="ShowClockBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="锁屏界面展示大数字时钟与星期日期" VerticalAlignment="Center" Margin="0,6,0,0"/>

                            <TextBlock Grid.Row="2" Text="遮罩透明度" VerticalAlignment="Center" Margin="0,6,0,0" Foreground="#FF444444"/>
                            <Slider x:Name="OpacitySlider" Grid.Row="2" Grid.Column="1" Minimum="0.3" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="0.88" Margin="0,6,0,0" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged"/>
                            <TextBlock x:Name="OpacityText" Grid.Row="2" Grid.Column="2" Text="88% (微透)" VerticalAlignment="Center" Foreground="#FF555555" Margin="8,6,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="0.30 最透 · 1.00 完全遮挡不透明" Foreground="#FF999999" FontSize="10" Margin="0,2,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 系统集成 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE4E7EB" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="系统集成" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,6"/>
                        <CheckBox x:Name="AutoStartBox" Content="开机自启（写入注册表 Run）" Margin="0,2,0,0"/>
                        <CheckBox x:Name="UnlockOnResumeBox" Content="Windows 解锁后自动解除伪锁屏（推荐开启）" Margin="0,6,0,0" IsChecked="True"/>
                        <TextBlock Text="系统锁屏解锁（密码/人脸）后，自动解除 ScreenLock，无需重复输入 PIN 码" Foreground="#FF888888" FontSize="11" Margin="20,2,0,0" TextWrapping="Wrap"/>
                        <CheckBox x:Name="TasksEnabledBox" Content="启用任务调度（全局总开关）" Margin="0,6,0,0" IsChecked="True"/>
                        <TextBlock Text="关闭后所有定时/热键/监听等自动化任务将全部暂停运行" Foreground="#FF888888" FontSize="11" Margin="20,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 排除进程 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE4E7EB" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="排除进程（防游戏 / 播放器挂机误锁）" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,4"/>
                        <TextBlock Text="列出的进程在前台或后台运行时自动暂停空闲计时，大小写不敏感" Foreground="#FF888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExcludeInputBox" Height="26" Padding="5,2" ToolTip="输入进程名如 eldenring.exe 回车快速添加"/>
                            <Button Content="从运行中选择..." Grid.Column="1" Height="26" Margin="4,0,0,0" Padding="8,0" Click="OnPickRunningProcessClick"/>
                            <Button Content="添加" Grid.Column="2" Height="26" Margin="4,0,0,0" Click="OnExcludeAddClick"/>
                            <Button Content="删除" Grid.Column="3" Height="26" Margin="4,0,0,0" Click="OnExcludeDeleteClick"/>
                        </Grid>
                        <ListBox x:Name="ExcludeList" Height="80" Margin="0,6,0,0" SelectionMode="Single" MouseDoubleClick="ExcludeList_MouseDoubleClick"/>
                        <TextBlock Text="提示：双击列表项可快捷删除；空列表表示不排除任何进程" Foreground="#FF999999" FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 安全设置 -->
                <Border Background="White" CornerRadius="6" BorderBrush="#FFE4E7EB" BorderThickness="1" Padding="12,8" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="安全设置" FontWeight="Bold" Foreground="#FF333333" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <TextBlock Text="PIN 状态" VerticalAlignment="Center" Foreground="#FF444444"/>
                            <TextBlock x:Name="PinStatusText" Grid.Column="1" Text="--" VerticalAlignment="Center" Foreground="#FF333333"/>
                            <Button x:Name="PinButton" Grid.Column="2" Content="修改 PIN" Height="26" Click="OnPinChangeClick"/>
                        </Grid>
                        <TextBlock Text="PIN 用于解锁屏幕与退出程序，修改后立即生效" Foreground="#FF888888" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ValidateText" Foreground="#FFD93025" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部固定底栏：质感微边框，按钮整齐 -->
        <Border Grid.Row="1" Background="#FFF9F9F9" BorderBrush="#FFE2E5E8" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button Content="恢复默认" DockPanel.Dock="Left" Height="30" Padding="12,0" ToolTip="还原为推荐默认设置（不影响 PIN）" Click="OnResetDefaultsClick"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="保存并应用" FontWeight="SemiBold" Height="30" Padding="16,0" Background="#FF1A73E8" Foreground="White" BorderThickness="0" Margin="0,0,8,0" Click="OnSaveApplyClick"/>
                    <Button Content="关闭" Height="30" Width="68" Click="OnCloseClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

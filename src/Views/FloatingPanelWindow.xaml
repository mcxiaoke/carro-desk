<Window x:Class="CarroDesk.Views.FloatingPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CarroDesk.Services.Localization"
        Title="CarroDesk Panel"
        Width="230" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="12" Foreground="#FF24292F">
    <Window.Resources>
        <!-- 分隔线样式 -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="#FFE9ECEF" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏小图标按钮样式 -->
        <Style x:Key="ToolButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFCBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通叶子菜单项模板 -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="8,6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" SharedSizeGroup="CheckGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ArrowGroup"/>
                    </Grid.ColumnDefinitions>

                    <!-- 勾选状态标记 -->
                    <Path x:Name="CheckMark" Data="M 0 4 L 3 7 L 8 1" Stroke="#FF1A73E8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>

                    <!-- 标题文本 -->
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="2,0,14,0"/>

                    <!-- 快捷手势文本 -->
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#FF888888" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FFF0F3F6"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 带有子菜单的菜单头项模板 -->
        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Margin="2,1" Padding="8,6" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" SharedSizeGroup="CheckGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ArrowGroup"/>
                    </Grid.ColumnDefinitions>

                    <!-- 勾选状态标记 -->
                    <Path x:Name="CheckMark" Data="M 0 4 L 3 7 L 8 1" Stroke="#FF1A73E8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed"/>

                    <!-- 标题文本 -->
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="2,0,14,0"/>

                    <!-- 右侧展开小箭头 -->
                    <Path Grid.Column="2" Data="M 0 0 L 4 4 L 0 8" Stroke="#FF666666" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="8,0,2,0"/>

                    <!-- 子菜单弹出层：自适应现代阴影微卡片 -->
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" VerticalOffset="-4" HorizontalOffset="2">
                        <Border Background="White" BorderBrush="#FFE2E5E8" BorderThickness="1" CornerRadius="8" Padding="4" SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.14" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FFF0F3F6"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="#FFE8ECEF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 菜单项默认样式 -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="True">
                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 窗口主卡片容器 -->
    <Border Background="White" BorderBrush="#FFE2E5E8" BorderThickness="1" CornerRadius="10" Padding="0" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 标题栏 / 工具栏 -->
                <RowDefinition Height="*"/>    <!-- 菜单内容区 -->
            </Grid.RowDefinitions>

            <!-- ① 顶部精致标题与控制手柄栏 -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Padding="10,6" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：图标 + 标题 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Loc Tray.FloatingPanel, Default='控制面板'}" FontWeight="SemiBold" FontSize="12" Foreground="#FF1E293B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 右侧：位置预设、锁定位置、停留桌面、收起 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Arrow">
                        <Button x:Name="BtnPosition" Style="{StaticResource ToolButtonStyle}" ToolTip="{loc:Loc Tray.PositionTooltip, Default='设置面板位置'}" Click="OnPositionClick">
                            <TextBlock Text="📍" FontSize="11"/>
                        </Button>
                        <Button x:Name="BtnLock" Style="{StaticResource ToolButtonStyle}" Click="OnLockClick" Margin="2,0,0,0">
                            <TextBlock x:Name="TxtLock" Text="🔓" FontSize="11" Foreground="#FF64748B"/>
                        </Button>
                        <Button x:Name="BtnPin" Style="{StaticResource ToolButtonStyle}" Click="OnPinClick" Margin="2,0,0,0">
                            <TextBlock x:Name="TxtPin" Text="📌" FontSize="11" Foreground="#FF64748B"/>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource ToolButtonStyle}" ToolTip="{loc:Loc Tray.CloseTooltip, Default='收起 (Esc)'}" Click="OnCloseClick" Margin="2,0,0,0">
                            <TextBlock Text="✕" FontSize="11" Foreground="#FF64748B"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ② 下方主菜单项容器（竖向排列并支持自适应弹出子菜单） -->
            <Border Grid.Row="1" Padding="4">
                <Menu x:Name="ItemsHostMenu" Background="Transparent" Grid.IsSharedSizeScope="True">
                    <Menu.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </Menu.ItemsPanel>
                </Menu>
            </Border>
        </Grid>
    </Border>
</Window>

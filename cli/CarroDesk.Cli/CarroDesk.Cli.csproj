<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CarroDesk.Cli</RootNamespace>
    <AssemblyName>CarroDesk.Cli</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CarroDesk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- 单文件由 dotnet publish -p:PublishSingleFile=true 产出（见 scripts/release.py）。
       构建阶段清理 ProjectReference 流入的样例文件，避免污染 Debug 输出目录。 -->
  <Target Name="CleanCliOutputJunk" AfterTargets="Build">
    <ItemGroup>
      <CliJunk Include="$(OutDir)config.sample.json;
                        $(OutDir)tasks.sample.json;
                        $(OutDir)portable.sample.ini" />
    </ItemGroup>
    <Delete Files="@(CliJunk)" />
  </Target>

</Project>
